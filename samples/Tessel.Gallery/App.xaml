<Application x:Class="Tessel.Gallery.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tessel="http://schemas.tessel.net/ui"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <tessel:ThemeResources Theme="System" />
            </ResourceDictionary.MergedDictionaries>

            <!--  Gallery helpers  -->
            <Style x:Key="PageTitle" BasedOn="{StaticResource Tessel.Text.Title}" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>
            <Style x:Key="PageDescription" BasedOn="{StaticResource Tessel.Text.Secondary}" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,0,0,24" />
            </Style>
            <Style x:Key="Section" TargetType="tessel:Card">
                <Setter Property="Margin" Value="0,0,0,16" />
            </Style>
            <Style x:Key="PageHost" TargetType="StackPanel">
                <Setter Property="Margin" Value="36,28,36,36" />
                <Setter Property="MaxWidth" Value="1040" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
            </Style>
            <Style x:Key="Row" TargetType="WrapPanel">
                <Setter Property="Orientation" Value="Horizontal" />
            </Style>
            <tessel:EnumToBooleanConverter x:Key="EnumToBool" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
