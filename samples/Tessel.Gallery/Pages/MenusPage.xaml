<UserControl x:Class="Tessel.Gallery.Pages.MenusPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tessel="http://schemas.tessel.net/ui">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Style="{StaticResource PageHost}">
            <TextBlock Style="{StaticResource PageTitle}" Text="Menus &amp; Tooltips" />
            <TextBlock Style="{StaticResource PageDescription}" Text="Menu bars, context menus, sub-menus, checkable items and tooltips." />

            <tessel:Card Header="Menu bar" Style="{StaticResource Section}">
                <Menu>
                    <MenuItem Header="_File">
                        <MenuItem Header="_New" Icon="{tessel:Glyph Add}" InputGestureText="Ctrl+N" />
                        <MenuItem Header="_Open…" Icon="{tessel:Glyph Folder}" InputGestureText="Ctrl+O" />
                        <MenuItem Header="_Save" Icon="{tessel:Glyph Save}" InputGestureText="Ctrl+S" />
                        <Separator />
                        <MenuItem Header="Recent">
                            <MenuItem Header="Report.docx" />
                            <MenuItem Header="Budget.xlsx" />
                            <MenuItem Header="Slides.pptx" />
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="E_xit" />
                    </MenuItem>
                    <MenuItem Header="_Edit">
                        <MenuItem Header="Undo" Icon="{tessel:Glyph Undo}" InputGestureText="Ctrl+Z" />
                        <MenuItem Header="Redo" Icon="{tessel:Glyph Redo}" InputGestureText="Ctrl+Y" />
                        <Separator />
                        <MenuItem Header="Cut" Icon="{tessel:Glyph Cut}" InputGestureText="Ctrl+X" />
                        <MenuItem Header="Copy" Icon="{tessel:Glyph Copy}" InputGestureText="Ctrl+C" />
                        <MenuItem Header="Paste" Icon="{tessel:Glyph Paste}" InputGestureText="Ctrl+V" IsEnabled="False" />
                    </MenuItem>
                    <MenuItem Header="_View">
                        <MenuItem Header="Status bar" IsCheckable="True" IsChecked="True" />
                        <MenuItem Header="Word wrap" IsCheckable="True" />
                        <MenuItem Header="Zoom">
                            <MenuItem Header="Zoom in" InputGestureText="Ctrl++" />
                            <MenuItem Header="Zoom out" InputGestureText="Ctrl+-" />
                            <MenuItem Header="Reset" InputGestureText="Ctrl+0" />
                        </MenuItem>
                    </MenuItem>
                    <MenuItem Header="_Help" />
                </Menu>
            </tessel:Card>

            <tessel:Card Header="ToolBar" Style="{StaticResource Section}">
                <ToolBarTray>
                    <ToolBar>
                        <Button Content="{tessel:Glyph Add}" FontFamily="{DynamicResource Tessel.IconFontFamily}" ToolTip="New" />
                        <Button Content="{tessel:Glyph Folder}" FontFamily="{DynamicResource Tessel.IconFontFamily}" ToolTip="Open" />
                        <Button Content="{tessel:Glyph Save}" FontFamily="{DynamicResource Tessel.IconFontFamily}" ToolTip="Save" />
                        <Separator />
                        <ToggleButton Content="{tessel:Glyph Font}" FontFamily="{DynamicResource Tessel.IconFontFamily}" IsChecked="True" ToolTip="Bold" />
                        <ToggleButton Content="{tessel:Glyph Code}" FontFamily="{DynamicResource Tessel.IconFontFamily}" ToolTip="Code" />
                        <Separator />
                        <ComboBox Width="130" SelectedIndex="0">
                            <ComboBoxItem Content="Segoe UI" />
                            <ComboBoxItem Content="Cascadia Mono" />
                        </ComboBox>
                        <Button Content="Overflow item 1" />
                        <Button Content="Overflow item 2" />
                    </ToolBar>
                    <ToolBar>
                        <Button Content="{tessel:Glyph Undo}" FontFamily="{DynamicResource Tessel.IconFontFamily}" ToolTip="Undo" />
                        <Button Content="{tessel:Glyph Redo}" FontFamily="{DynamicResource Tessel.IconFontFamily}" ToolTip="Redo" />
                    </ToolBar>
                </ToolBarTray>
            </tessel:Card>

            <tessel:Card Header="Frame" Style="{StaticResource Section}">
                <Frame Height="70">
                    <Frame.Content>
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource Tessel.Text.Secondary}" Text="A Frame hosts a page or any content without the default navigation chrome." />
                    </Frame.Content>
                </Frame>
            </tessel:Card>

            <tessel:Card Header="Context menu" Style="{StaticResource Section}">
                <Border Height="120"
                        Background="{DynamicResource Tessel.SubtleBrush}"
                        BorderBrush="{DynamicResource Tessel.BorderStrongBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource Tessel.OverlayCornerRadius}">
                    <Border.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Open" Icon="{tessel:Glyph Page}" />
                            <MenuItem Header="Rename" Icon="{tessel:Glyph Rename}" InputGestureText="F2" />
                            <MenuItem Header="Share" Icon="{tessel:Glyph Share}">
                                <MenuItem Header="Email" Icon="{tessel:Glyph Mail}" />
                                <MenuItem Header="Copy link" Icon="{tessel:Glyph Link}" />
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="Pin to start" Icon="{tessel:Glyph Pin}" IsCheckable="True" />
                            <MenuItem Header="Delete" Icon="{tessel:Glyph Delete}" InputGestureText="Del" />
                        </ContextMenu>
                    </Border.ContextMenu>
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Tessel.Text.Secondary}" Text="Right-click anywhere in this area" />
                </Border>
            </tessel:Card>

            <tessel:Card Header="Tooltips" Style="{StaticResource Section}">
                <WrapPanel>
                    <Button Margin="0,0,8,0" Content="Hover me" ToolTip="A simple text tooltip" />
                    <Button Margin="0,0,8,0" Content="Rich tooltip">
                        <Button.ToolTip>
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="Keyboard shortcut" />
                                <TextBlock Margin="0,2,0,0" Foreground="{DynamicResource Tessel.TextSecondaryBrush}" Text="Press Ctrl+K to open the command palette." />
                            </StackPanel>
                        </Button.ToolTip>
                    </Button>
                    <Button Content="{tessel:Glyph Help}" Style="{StaticResource Tessel.Button.Icon}" ToolTip="Tooltips wrap long text automatically so they never grow wider than a comfortable reading width." />
                </WrapPanel>
            </tessel:Card>

            <tessel:Card Header="Status bar" Style="{StaticResource Section}">
                <StatusBar>
                    <StatusBarItem Content="Ready" />
                    <Separator />
                    <StatusBarItem Content="Ln 12, Col 4" />
                    <Separator />
                    <StatusBarItem Content="UTF-8" />
                </StatusBar>
            </tessel:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
