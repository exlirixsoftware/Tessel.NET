<UserControl x:Class="Tessel.Gallery.Pages.CollectionsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:Tessel.Gallery.Models"
             xmlns:tessel="http://schemas.tessel.net/ui">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Style="{StaticResource PageHost}">
            <TextBlock Style="{StaticResource PageTitle}" Text="Collections" />
            <TextBlock Style="{StaticResource PageDescription}" Text="Data grids, lists, trees and tabs." />

            <tessel:Card Header="DataGrid" Style="{StaticResource Section}">
                <DataGrid Height="320"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          ItemsSource="{x:Static models:SampleData.Employees}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="2*" Header="Name" SortMemberPath="Name">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="models:Employee">
                                    <StackPanel Orientation="Horizontal">
                                        <tessel:Avatar Width="28" Height="28" Margin="0,0,10,0" DisplayName="{Binding Name}" />
                                        <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Width="2*" Binding="{Binding Role}" Header="Role" />
                        <DataGridTextColumn Width="*" Binding="{Binding Team}" Header="Team" />
                        <DataGridTextColumn Width="*" Binding="{Binding StartDate, StringFormat=d}" Header="Start date" />
                        <DataGridTextColumn Width="*" Binding="{Binding Salary, StringFormat=C0}" Header="Salary" />
                        <DataGridTemplateColumn Width="*" Header="Status" SortMemberPath="IsActive">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="models:Employee">
                                    <tessel:Badge x:Name="Status" Content="Inactive" Kind="Neutral" />
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <Setter TargetName="Status" Property="Content" Value="Active" />
                                            <Setter TargetName="Status" Property="Kind" Value="Success" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </tessel:Card>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <tessel:Card Header="ListBox">
                    <ListBox Height="260" ItemsSource="{x:Static models:SampleData.Employees}" SelectedIndex="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="models:Employee">
                                <StackPanel Orientation="Horizontal">
                                    <tessel:Avatar Width="32" Height="32" Margin="0,0,12,0" DisplayName="{Binding Name}" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" />
                                        <TextBlock Style="{StaticResource Tessel.Text.Caption}" Text="{Binding Role}" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </tessel:Card>
                <tessel:Card Grid.Column="2" Header="TreeView">
                    <TreeView Height="260" ItemsSource="{x:Static models:SampleData.Folders}">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate DataType="models:FolderNode" ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Margin="0,0,10,0"
                                               Foreground="{DynamicResource Tessel.AccentBrush}"
                                               Style="{StaticResource Tessel.Text.Icon}"
                                               Text="{Binding Glyph}" />
                                    <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                        <TreeView.ItemContainerStyle>
                            <Style BasedOn="{StaticResource {x:Type TreeViewItem}}" TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="True" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                    </TreeView>
                </tessel:Card>
            </Grid>

            <tessel:Card Header="ListView / GridView" Style="{StaticResource Section}">
                <ListView Height="240" ItemsSource="{x:Static models:SampleData.Employees}" SelectedIndex="1">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Width="220" DisplayMemberBinding="{Binding Name}" Header="Name" />
                            <GridViewColumn Width="200" DisplayMemberBinding="{Binding Role}" Header="Role" />
                            <GridViewColumn Width="150" DisplayMemberBinding="{Binding Team}" Header="Team" />
                            <GridViewColumn Width="120" DisplayMemberBinding="{Binding StartDate, StringFormat=d}" Header="Start date" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </tessel:Card>

            <tessel:Card Header="TabControl" Style="{StaticResource Section}">
                <TabControl Height="140">
                    <TabItem Header="Overview">
                        <TextBlock Style="{StaticResource Tessel.Text.Secondary}" Text="Tabs use an accent underline for the selected item and a subtle hover highlight." />
                    </TabItem>
                    <TabItem Header="Activity">
                        <StackPanel>
                            <TextBlock Text="12 commits this week" />
                            <ProgressBar Margin="0,12,0,0" Value="60" />
                        </StackPanel>
                    </TabItem>
                    <TabItem Header="Members">
                        <StackPanel Orientation="Horizontal">
                            <tessel:Avatar Margin="0,0,-8,0" DisplayName="Ada Lovelace" />
                            <tessel:Avatar Margin="0,0,-8,0" DisplayName="Grace Hopper" />
                            <tessel:Avatar Margin="0,0,-8,0" DisplayName="Alan Turing" />
                            <tessel:Avatar DisplayName="Katherine Johnson" />
                        </StackPanel>
                    </TabItem>
                    <TabItem Header="Disabled" IsEnabled="False" />
                </TabControl>
            </tessel:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
