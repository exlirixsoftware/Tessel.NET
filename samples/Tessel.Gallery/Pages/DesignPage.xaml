<UserControl x:Class="Tessel.Gallery.Pages.DesignPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tessel="http://schemas.tessel.net/ui">
    <UserControl.Resources>
        <Style x:Key="Swatch" TargetType="Border">
            <Setter Property="Height" Value="56" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="CornerRadius" Value="{DynamicResource Tessel.ControlCornerRadius}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Tessel.BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="SwatchLabel" BasedOn="{StaticResource Tessel.Text.Caption}" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="FontFamily" Value="{DynamicResource Tessel.MonoFontFamily}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Style="{StaticResource PageHost}">
            <TextBlock Style="{StaticResource PageTitle}" Text="Colors &amp; Typography" />
            <TextBlock Style="{StaticResource PageDescription}" Text="Design tokens exposed as resources. Use them with {DynamicResource …} so they follow theme changes." />

            <tessel:Card Header="Typography" Style="{StaticResource Section}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Tessel.Text.Display}" Text="Display" />
                    <TextBlock Style="{StaticResource Tessel.Text.Title}" Text="Title" />
                    <TextBlock Style="{StaticResource Tessel.Text.Subtitle}" Text="Subtitle" />
                    <TextBlock Style="{StaticResource Tessel.Text.BodyStrong}" Text="Body strong" />
                    <TextBlock Style="{StaticResource Tessel.Text.Body}" Text="Body — The quick brown fox jumps over the lazy dog." />
                    <TextBlock Style="{StaticResource Tessel.Text.Secondary}" Text="Secondary — Supporting text with lower emphasis." />
                    <TextBlock Style="{StaticResource Tessel.Text.Caption}" Text="Caption — Small print and metadata." />
                    <TextBlock Style="{StaticResource Tessel.Text.Code}" Text="Code — var theme = ThemeManager.ActualTheme;" />
                </StackPanel>
            </tessel:Card>

            <tessel:Card Header="Surfaces &amp; text" Style="{StaticResource Section}">
                <UniformGrid Columns="5">
                    <StackPanel Margin="0,0,8,0">
                        <Border Background="{DynamicResource Tessel.BackgroundBrush}" Style="{StaticResource Swatch}" />
                        <TextBlock Style="{StaticResource SwatchLabel}" Text="Background" />
                    </StackPanel>
                    <StackPanel Margin="4,0">
                        <Border Background="{DynamicResource Tessel.SurfaceBrush}" Style="{StaticResource Swatch}" />
                        <TextBlock Style="{StaticResource SwatchLabel}" Text="Surface" />
                    </StackPanel>
                    <StackPanel Margin="4,0">
                        <Border Background="{DynamicResource Tessel.SurfaceAltBrush}" Style="{StaticResource Swatch}" />
                        <TextBlock Style="{StaticResource SwatchLabel}" Text="SurfaceAlt" />
                    </StackPanel>
                    <StackPanel Margin="4,0">
                        <Border Background="{DynamicResource Tessel.SubtleBrush}" Style="{StaticResource Swatch}" />
                        <TextBlock Style="{StaticResource SwatchLabel}" Text="Subtle" />
                    </StackPanel>
                    <StackPanel Margin="8,0,0,0">
                        <Border Background="{DynamicResource Tessel.BorderStrongBrush}" Style="{StaticResource Swatch}" />
                        <TextBlock Style="{StaticResource SwatchLabel}" Text="BorderStrong" />
                    </StackPanel>
                    <StackPanel Margin="0,0,8,0">
                        <Border Background="{DynamicResource Tessel.TextBrush}" Style="{StaticResource Swatch}" />
                        <TextBlock Style="{StaticResource SwatchLabel}" Text="Text" />
                    </StackPanel>
                    <StackPanel Margin="4,0">
                        <Border Background="{DynamicResource Tessel.TextSecondaryBrush}" Style="{StaticResource Swatch}" />
                        <TextBlock Style="{StaticResource SwatchLabel}" Text="TextSecondary" />
                    </StackPanel>
                    <StackPanel Margin="4,0">
                        <Border Background="{DynamicResource Tessel.TextTertiaryBrush}" Style="{StaticResource Swatch}" />
                        <TextBlock Style="{StaticResource SwatchLabel}" Text="TextTertiary" />
                    </StackPanel>
                    <StackPanel Margin="4,0">
                        <Border Background="{DynamicResource Tessel.ControlHoverBrush}" Style="{StaticResource Swatch}" />
                        <TextBlock Style="{StaticResource SwatchLabel}" Text="ControlHover" />
                    </StackPanel>
                    <StackPanel Margin="8,0,0,0">
                        <Border Background="{DynamicResource Tessel.ControlPressedBrush}" Style="{StaticResource Swatch}" />
                        <TextBlock Style="{StaticResource SwatchLabel}" Text="ControlPressed" />
                    </StackPanel>
                </UniformGrid>
            </tessel:Card>

            <tessel:Card Header="Accent &amp; semantic" Style="{StaticResource Section}">
                <UniformGrid Columns="5">
                    <StackPanel Margin="0,0,8,0">
                        <Border Background="{DynamicResource Tessel.AccentBrush}" Style="{StaticResource Swatch}" />
                        <TextBlock Style="{StaticResource SwatchLabel}" Text="Accent" />
                    </StackPanel>
                    <StackPanel Margin="4,0">
                        <Border Background="{DynamicResource Tessel.SuccessBrush}" Style="{StaticResource Swatch}" />
                        <TextBlock Style="{StaticResource SwatchLabel}" Text="Success" />
                    </StackPanel>
                    <StackPanel Margin="4,0">
                        <Border Background="{DynamicResource Tessel.WarningBrush}" Style="{StaticResource Swatch}" />
                        <TextBlock Style="{StaticResource SwatchLabel}" Text="Warning" />
                    </StackPanel>
                    <StackPanel Margin="4,0">
                        <Border Background="{DynamicResource Tessel.DangerBrush}" Style="{StaticResource Swatch}" />
                        <TextBlock Style="{StaticResource SwatchLabel}" Text="Danger" />
                    </StackPanel>
                    <StackPanel Margin="8,0,0,0">
                        <Border Background="{DynamicResource Tessel.InfoBrush}" Style="{StaticResource Swatch}" />
                        <TextBlock Style="{StaticResource SwatchLabel}" Text="Info" />
                    </StackPanel>
                    <StackPanel Margin="0,0,8,0">
                        <Border Background="{DynamicResource Tessel.AccentSubtleBrush}" Style="{StaticResource Swatch}" />
                        <TextBlock Style="{StaticResource SwatchLabel}" Text="AccentSubtle" />
                    </StackPanel>
                    <StackPanel Margin="4,0">
                        <Border Background="{DynamicResource Tessel.SuccessSubtleBrush}" Style="{StaticResource Swatch}" />
                        <TextBlock Style="{StaticResource SwatchLabel}" Text="SuccessSubtle" />
                    </StackPanel>
                    <StackPanel Margin="4,0">
                        <Border Background="{DynamicResource Tessel.WarningSubtleBrush}" Style="{StaticResource Swatch}" />
                        <TextBlock Style="{StaticResource SwatchLabel}" Text="WarningSubtle" />
                    </StackPanel>
                    <StackPanel Margin="4,0">
                        <Border Background="{DynamicResource Tessel.DangerSubtleBrush}" Style="{StaticResource Swatch}" />
                        <TextBlock Style="{StaticResource SwatchLabel}" Text="DangerSubtle" />
                    </StackPanel>
                    <StackPanel Margin="8,0,0,0">
                        <Border Background="{DynamicResource Tessel.InfoSubtleBrush}" Style="{StaticResource Swatch}" />
                        <TextBlock Style="{StaticResource SwatchLabel}" Text="InfoSubtle" />
                    </StackPanel>
                </UniformGrid>
            </tessel:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
