<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Tessel.UI.Controls">

    <Style x:Key="Tessel.NavigationPaneButton" TargetType="{x:Type Button}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Tessel.TextBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource Tessel.IconFontFamily}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource Tessel.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource Tessel.ControlCornerRadius}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Tessel.ControlHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Tessel.ControlPressedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Tessel.NavigationList" TargetType="{x:Type ListBox}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBox}">
                    <ScrollViewer Focusable="False"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  NavigationViewItem  -->
    <Style TargetType="{x:Type c:NavigationViewItem}">
        <Setter Property="Foreground" Value="{DynamicResource Tessel.TextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Margin" Value="8,2" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource Tessel.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:NavigationViewItem}">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource Tessel.ControlCornerRadius}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Pill"
                                    Width="3"
                                    Height="16"
                                    HorizontalAlignment="Left"
                                    Background="{DynamicResource Tessel.AccentBrush}"
                                    CornerRadius="1.5"
                                    Visibility="Collapsed" />
                            <ContentPresenter x:Name="Icon"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding Icon}"
                                              TextElement.FontFamily="{DynamicResource Tessel.IconFontFamily}"
                                              TextElement.FontSize="16" />
                            <ContentPresenter Grid.Column="1"
                                              Margin="2,0,12,0"
                                              VerticalAlignment="Center">
                                <ContentPresenter.Resources>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Tessel.ControlHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Tessel.ControlPressedBrush}" />
                            <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Icon" Property="TextElement.Foreground" Value="{DynamicResource Tessel.AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  NavigationViewItemHeader  -->
    <Style TargetType="{x:Type c:NavigationViewItemHeader}">
        <Setter Property="Foreground" Value="{DynamicResource Tessel.TextSecondaryBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource Tessel.FontSizeSmall}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:NavigationViewItemHeader}">
                    <Grid Height="36">
                        <ContentPresenter x:Name="Text"
                                          Margin="20,12,12,0"
                                          VerticalAlignment="Center" />
                        <Border x:Name="Line"
                                Height="1"
                                Margin="16,12,16,0"
                                VerticalAlignment="Center"
                                Background="{DynamicResource Tessel.BorderBrush}"
                                Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsPaneOpen, RelativeSource={RelativeSource AncestorType={x:Type c:NavigationView}}}" Value="False">
                            <Setter TargetName="Text" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Line" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  NavigationView  -->
    <Style TargetType="{x:Type c:NavigationView}">
        <Setter Property="Foreground" Value="{DynamicResource Tessel.TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource Tessel.SurfaceAltBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Tessel.BorderBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:NavigationView}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <DockPanel x:Name="Pane" Width="{TemplateBinding OpenPaneLength}">
                            <DockPanel Height="44" DockPanel.Dock="Top">
                                <Button x:Name="PART_PaneToggleButton"
                                        Margin="8,4,4,4"
                                        Content="&#xE700;"
                                        DockPanel.Dock="Left"
                                        Style="{StaticResource Tessel.NavigationPaneButton}"
                                        ToolTip="Toggle navigation" />
                                <ContentPresenter x:Name="PaneTitle"
                                                  Margin="8,0,12,0"
                                                  VerticalAlignment="Center"
                                                  Content="{TemplateBinding PaneTitle}"
                                                  TextElement.FontWeight="SemiBold" />
                            </DockPanel>
                            <ContentPresenter x:Name="PaneHeader"
                                              Margin="12,4,12,8"
                                              Content="{TemplateBinding PaneHeader}"
                                              DockPanel.Dock="Top" />
                            <ListBox x:Name="PART_FooterList"
                                     Margin="0,4,0,8"
                                     DockPanel.Dock="Bottom"
                                     ItemsSource="{TemplateBinding FooterMenuItems}"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                     Style="{StaticResource Tessel.NavigationList}" />
                            <ListBox x:Name="PART_MenuList"
                                     ItemsSource="{TemplateBinding MenuItems}"
                                     Style="{StaticResource Tessel.NavigationList}" />
                        </DockPanel>

                        <Border Grid.Column="1"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1,1,0,0"
                                ClipToBounds="True"
                                CornerRadius="8,0,0,0">
                            <ContentPresenter x:Name="PART_ContentPresenter"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPaneOpen" Value="False">
                            <Setter TargetName="Pane" Property="Width" Value="{Binding CompactPaneLength, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="PaneTitle" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PaneHeader" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="PaneHeader" Value="{x:Null}">
                            <Setter TargetName="PaneHeader" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsPaneToggleButtonVisible" Value="False">
                            <Setter TargetName="PART_PaneToggleButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
