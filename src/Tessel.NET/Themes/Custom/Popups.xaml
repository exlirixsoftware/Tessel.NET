<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Tessel.NET.Controls">

    <!--  Flyout  -->
    <Style TargetType="{x:Type c:Flyout}">
        <Setter Property="Background" Value="{DynamicResource Tessel.SurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource Tessel.TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Tessel.BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="FontFamily" Value="{DynamicResource Tessel.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Tessel.FontSize}" />
        <Setter Property="Width" Value="0" />
        <Setter Property="Height" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:Flyout}">
                    <Popup x:Name="PART_Popup"
                           AllowsTransparency="True"
                           Focusable="False"
                           IsOpen="{Binding IsOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                           PopupAnimation="Fade">
                        <Border Margin="8,4,8,12"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource Tessel.OverlayCornerRadius}"
                                Effect="{DynamicResource Tessel.Shadow}"
                                TextElement.Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter MaxWidth="360">
                                <ContentPresenter.Resources>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                    </Popup>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  TeachingTip  -->
    <Style TargetType="{x:Type c:TeachingTip}">
        <Setter Property="Background" Value="{DynamicResource Tessel.SurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource Tessel.TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Tessel.BorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="FontFamily" Value="{DynamicResource Tessel.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Tessel.FontSize}" />
        <Setter Property="Width" Value="0" />
        <Setter Property="Height" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:TeachingTip}">
                    <Popup x:Name="PART_Popup"
                           AllowsTransparency="True"
                           Focusable="False"
                           IsOpen="{Binding IsOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                           PopupAnimation="Fade">
                        <Border Width="320"
                                Margin="8,4,8,12"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource Tessel.OverlayCornerRadius}"
                                Effect="{DynamicResource Tessel.ShadowLarge}"
                                TextElement.Foreground="{TemplateBinding Foreground}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="Icon"
                                           Margin="0,2,10,0"
                                           VerticalAlignment="Top"
                                           FontFamily="{DynamicResource Tessel.IconFontFamily}"
                                           FontSize="18"
                                           Foreground="{DynamicResource Tessel.AccentBrush}"
                                           Text="{TemplateBinding Icon}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock x:Name="Title"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Text="{TemplateBinding Title}"
                                               TextWrapping="Wrap" />
                                    <TextBlock x:Name="Subtitle"
                                               Margin="0,4,0,0"
                                               Foreground="{DynamicResource Tessel.TextSecondaryBrush}"
                                               Text="{TemplateBinding Subtitle}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <Button x:Name="PART_CloseButton"
                                        Grid.Column="2"
                                        Width="26"
                                        Height="26"
                                        Margin="8,-4,-6,0"
                                        VerticalAlignment="Top"
                                        Content="&#xE711;"
                                        FontFamily="{DynamicResource Tessel.IconFontFamily}"
                                        FontSize="10"
                                        Style="{DynamicResource Tessel.Button.Icon}" />

                                <ContentPresenter x:Name="Body"
                                                  Grid.Row="1"
                                                  Grid.ColumnSpan="3"
                                                  Margin="0,12,0,0" />

                                <StackPanel x:Name="Buttons"
                                            Grid.Row="2"
                                            Grid.ColumnSpan="3"
                                            Margin="0,16,0,0"
                                            HorizontalAlignment="Right"
                                            Orientation="Horizontal">
                                    <Button x:Name="PART_DismissButton"
                                            MinWidth="88"
                                            Margin="0,0,8,0"
                                            Content="{TemplateBinding CloseButtonContent}" />
                                    <Button x:Name="PART_ActionButton"
                                            MinWidth="88"
                                            Content="{TemplateBinding ActionButtonContent}"
                                            Style="{DynamicResource Tessel.Button.Accent}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Popup>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Icon" Value="">
                            <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Title" Value="">
                            <Setter TargetName="Title" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Subtitle" Value="">
                            <Setter TargetName="Subtitle" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsClosable" Value="False">
                            <Setter TargetName="PART_CloseButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="HasContent" Value="False">
                            <Setter TargetName="Body" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="ActionButtonContent" Value="{x:Null}">
                            <Setter TargetName="PART_ActionButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="CloseButtonContent" Value="{x:Null}">
                            <Setter TargetName="PART_DismissButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="ActionButtonContent" Value="{x:Null}" />
                                <Condition Property="CloseButtonContent" Value="{x:Null}" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Buttons" Property="Visibility" Value="Collapsed" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
