<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Tessel.NET.Controls">

    <!--  RatingControl  -->
    <Style TargetType="{x:Type c:RatingControl}">
        <Setter Property="Foreground" Value="{DynamicResource Tessel.AccentBrush}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontFamily" Value="{DynamicResource Tessel.FontFamily}" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="IsTabStop" Value="True" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource Tessel.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:RatingControl}">
                    <StackPanel Background="Transparent" Orientation="Horizontal">
                        <StackPanel x:Name="PART_Stars" Background="Transparent" Orientation="Horizontal" />
                        <TextBlock x:Name="CaptionText"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="{DynamicResource Tessel.FontSize}"
                                   Foreground="{DynamicResource Tessel.TextSecondaryBrush}"
                                   Text="{TemplateBinding Caption}" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Caption" Value="">
                            <Setter TargetName="CaptionText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ColorPicker  -->
    <DrawingBrush x:Key="Tessel.CheckerBrush"
                  TileMode="Tile"
                  Viewbox="0,0,8,8"
                  ViewboxUnits="Absolute"
                  Viewport="0,0,8,8"
                  ViewportUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="White">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,8,8" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FFCFCFCF">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <RectangleGeometry Rect="0,0,4,4" />
                            <RectangleGeometry Rect="4,4,4,4" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <DropShadowEffect x:Key="Tessel.ThumbShadow"
                      BlurRadius="4"
                      Opacity="0.55"
                      ShadowDepth="0"
                      Color="Black" />

    <Style TargetType="{x:Type c:ColorPicker}">
        <Setter Property="Foreground" Value="{DynamicResource Tessel.TextBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource Tessel.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Tessel.FontSize}" />
        <Setter Property="Width" Value="260" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:ColorPicker}">
                    <StackPanel>
                        <!--  Saturation / brightness field  -->
                        <Grid x:Name="PART_Spectrum"
                              Height="160"
                              Cursor="Cross"
                              SnapsToDevicePixels="True">
                            <Rectangle x:Name="PART_SpectrumBase"
                                       Fill="Red"
                                       RadiusX="6"
                                       RadiusY="6" />
                            <Rectangle RadiusX="6" RadiusY="6">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Offset="0" Color="#FFFFFFFF" />
                                        <GradientStop Offset="1" Color="#00FFFFFF" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Rectangle RadiusX="6" RadiusY="6">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Offset="0" Color="#00000000" />
                                        <GradientStop Offset="1" Color="#FF000000" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Rectangle RadiusX="6"
                                       RadiusY="6"
                                       Stroke="{DynamicResource Tessel.BorderBrush}"
                                       StrokeThickness="1" />
                            <Canvas IsHitTestVisible="False">
                                <Ellipse x:Name="PART_SpectrumThumb"
                                         Width="16"
                                         Height="16"
                                         Effect="{StaticResource Tessel.ThumbShadow}"
                                         Stroke="White"
                                         StrokeThickness="2" />
                            </Canvas>
                        </Grid>

                        <!--  Hue  -->
                        <Grid Margin="0,14,0,0">
                            <Border x:Name="PART_HueStrip"
                                    Height="14"
                                    Cursor="Hand"
                                    CornerRadius="7">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Offset="0" Color="#FFFF0000" />
                                        <GradientStop Offset="0.1667" Color="#FFFFFF00" />
                                        <GradientStop Offset="0.3333" Color="#FF00FF00" />
                                        <GradientStop Offset="0.5" Color="#FF00FFFF" />
                                        <GradientStop Offset="0.6667" Color="#FF0000FF" />
                                        <GradientStop Offset="0.8333" Color="#FFFF00FF" />
                                        <GradientStop Offset="1" Color="#FFFF0000" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Canvas Height="14" IsHitTestVisible="False">
                                <Ellipse x:Name="PART_HueThumb"
                                         Width="18"
                                         Height="18"
                                         Effect="{StaticResource Tessel.ThumbShadow}"
                                         Stroke="White"
                                         StrokeThickness="2" />
                            </Canvas>
                        </Grid>

                        <!--  Alpha  -->
                        <Grid x:Name="PART_AlphaStrip"
                              Height="14"
                              Margin="0,10,0,0"
                              Cursor="Hand">
                            <Border Background="{StaticResource Tessel.CheckerBrush}" CornerRadius="7" />
                            <Rectangle x:Name="PART_AlphaFill"
                                       RadiusX="7"
                                       RadiusY="7" />
                            <Canvas IsHitTestVisible="False">
                                <Ellipse x:Name="PART_AlphaThumb"
                                         Width="18"
                                         Height="18"
                                         Effect="{StaticResource Tessel.ThumbShadow}"
                                         Stroke="White"
                                         StrokeThickness="2" />
                            </Canvas>
                        </Grid>

                        <!--  Preview and hex code  -->
                        <Grid x:Name="HexRow" Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="40"
                                    Height="32"
                                    Margin="0,0,10,0"
                                    BorderBrush="{DynamicResource Tessel.BorderStrongBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <Grid>
                                    <Border Background="{StaticResource Tessel.CheckerBrush}" CornerRadius="5" />
                                    <Border x:Name="PART_Preview" CornerRadius="5" />
                                </Grid>
                            </Border>
                            <TextBox x:Name="PART_HexBox"
                                     Grid.Column="1"
                                     FontFamily="{DynamicResource Tessel.MonoFontFamily}"
                                     MaxLength="9" />
                        </Grid>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHexInputVisible" Value="False">
                            <Setter TargetName="HexRow" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
