<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Tessel.NET.Controls"
                    xmlns:h="clr-namespace:Tessel.NET.Helpers">

    <BooleanToVisibilityConverter x:Key="ToVisibility" />

    <!--  CommandPalette  -->
    <Style TargetType="{x:Type c:CommandPalette}">
        <Setter Property="Foreground" Value="{DynamicResource Tessel.TextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:CommandPalette}">
                    <ControlTemplate.Resources>
                        <DataTemplate x:Key="Item" DataType="{x:Type c:PaletteItem}">
                            <Grid x:Name="Row" Margin="2,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center"
                                           FontFamily="{DynamicResource Tessel.IconFontFamily}"
                                           FontSize="15"
                                           Foreground="{DynamicResource Tessel.AccentBrush}"
                                           Text="{Binding Glyph}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Title}" />
                                        <TextBlock Margin="8,0,0,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource Tessel.TextTertiaryBrush}"
                                                   Text="{Binding Category}" />
                                    </StackPanel>
                                    <TextBlock FontSize="11.5"
                                               Foreground="{DynamicResource Tessel.TextSecondaryBrush}"
                                               Text="{Binding Description}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Border Grid.Column="2"
                                        Margin="12,0,4,0"
                                        Padding="7,2"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource Tessel.SurfaceAltBrush}"
                                        CornerRadius="4">
                                    <Border.Style>
                                        <Style TargetType="{x:Type Border}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Shortcut}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="11"
                                               Foreground="{DynamicResource Tessel.TextSecondaryBrush}"
                                               Text="{Binding Shortcut}" />
                                </Border>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                    <Setter TargetName="Row" Property="Opacity" Value="0.45" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ControlTemplate.Resources>

                    <Grid x:Name="PART_Backdrop" Background="#66000000">
                        <Border Width="580"
                                MaxHeight="480"
                                Margin="0,90,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                Background="{DynamicResource Tessel.SurfaceBrush}"
                                BorderBrush="{DynamicResource Tessel.BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource Tessel.OverlayCornerRadius}"
                                Effect="{DynamicResource Tessel.Shadow}">
                            <DockPanel>
                                <TextBox x:Name="PART_Search"
                                         Margin="12"
                                         DockPanel.Dock="Top"
                                         h:ControlHelper.PlaceholderText="{Binding Placeholder, RelativeSource={RelativeSource TemplatedParent}}" />
                                <Border Height="1"
                                        Background="{DynamicResource Tessel.BorderBrush}"
                                        DockPanel.Dock="Top" />
                                <ListBox x:Name="PART_List"
                                         Margin="6"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         ItemTemplate="{StaticResource Item}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                            </DockPanel>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  TagInput  -->
    <Style TargetType="{x:Type c:TagInput}">
        <Setter Property="Background" Value="{DynamicResource Tessel.SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Tessel.BorderStrongBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource Tessel.TextBrush}" />
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="Cursor" Value="IBeam" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:TagInput}">
                    <Grid>
                        <Border x:Name="Bd"
                                Padding="4,2"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource Tessel.ControlCornerRadius}">
                            <WrapPanel x:Name="PART_Panel" VerticalAlignment="Center" />
                        </Border>
                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               Focusable="False"
                               Placement="Bottom"
                               PlacementTarget="{Binding ElementName=Bd}"
                               PopupAnimation="Fade"
                               StaysOpen="False"
                               VerticalOffset="-4">
                            <Border Width="{Binding ActualWidth, ElementName=Bd}"
                                    Margin="8,4,8,12"
                                    Background="{DynamicResource Tessel.SurfaceBrush}"
                                    BorderBrush="{DynamicResource Tessel.BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource Tessel.OverlayCornerRadius}"
                                    Effect="{DynamicResource Tessel.Shadow}">
                                <ListBox x:Name="PART_List"
                                         MaxHeight="220"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Focusable="False" />
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Tessel.AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  MentionBox  -->
    <Style TargetType="{x:Type c:MentionBox}">
        <Setter Property="MinHeight" Value="80" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:MentionBox}">
                    <Grid>
                        <TextBox x:Name="PART_TextBox"
                                 MinHeight="{TemplateBinding MinHeight}"
                                 VerticalContentAlignment="Top"
                                 AcceptsReturn="{Binding AcceptsReturn, RelativeSource={RelativeSource TemplatedParent}}"
                                 TextWrapping="{Binding TextWrapping, RelativeSource={RelativeSource TemplatedParent}}"
                                 VerticalScrollBarVisibility="Auto" />
                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="Fade"
                               StaysOpen="False">
                            <Border MinWidth="200"
                                    Margin="8,4,8,12"
                                    Background="{DynamicResource Tessel.SurfaceBrush}"
                                    BorderBrush="{DynamicResource Tessel.BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource Tessel.OverlayCornerRadius}"
                                    Effect="{DynamicResource Tessel.Shadow}">
                                <ListBox x:Name="PART_List"
                                         MaxHeight="200"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Focusable="False" />
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  PropertyGrid  -->
    <Style TargetType="{x:Type c:PropertyGrid}">
        <Setter Property="Background" Value="{DynamicResource Tessel.SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Tessel.BorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource Tessel.TextBrush}" />
        <Setter Property="MinWidth" Value="260" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:PropertyGrid}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Tessel.OverlayCornerRadius}">
                        <DockPanel>
                            <StackPanel Margin="14,12,14,6" DockPanel.Dock="Top">
                                <TextBlock FontSize="14"
                                           FontWeight="SemiBold"
                                           Text="{Binding HeaderText, RelativeSource={RelativeSource TemplatedParent}}" />
                                <TextBox x:Name="PART_Search"
                                         Margin="0,8,0,0"
                                         h:ControlHelper.PlaceholderText="Search properties"
                                         Visibility="{Binding ShowSearch, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ToVisibility}}" />
                            </StackPanel>
                            <ScrollViewer Padding="0,0,2,0" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="PART_Host" Margin="8,2,8,10" />
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  GanttChart draws itself; the template only holds the two scroll bars.  -->
    <Style TargetType="{x:Type c:GanttChart}">
        <Setter Property="Background" Value="{DynamicResource Tessel.SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Tessel.BorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource Tessel.TextBrush}" />
        <Setter Property="BarBrush" Value="{DynamicResource Tessel.AccentBrush}" />
        <Setter Property="GridBrush" Value="{DynamicResource Tessel.BorderBrush}" />
        <Setter Property="WeekendBrush" Value="{DynamicResource Tessel.SurfaceAltBrush}" />
        <Setter Property="TodayBrush" Value="{DynamicResource Tessel.DangerBrush}" />
        <Setter Property="MinHeight" Value="200" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:GanttChart}">
                    <Grid Background="Transparent">
                        <ScrollBar x:Name="PART_VScroll"
                                   HorizontalAlignment="Right"
                                   Orientation="Vertical"
                                   Visibility="Collapsed" />
                        <ScrollBar x:Name="PART_HScroll"
                                   VerticalAlignment="Bottom"
                                   Orientation="Horizontal"
                                   Visibility="Collapsed" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  DockingManager builds its layout in code inside PART_Root; DockPane shows its content.  -->
    <Style TargetType="{x:Type c:DockingManager}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:DockingManager}">
                    <Grid x:Name="PART_Root" Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type c:DockPane}">
        <Setter Property="Background" Value="{DynamicResource Tessel.SurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource Tessel.TextBrush}" />
        <Setter Property="Padding" Value="10" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:DockPane}">
                    <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
