<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Tessel.NET.Controls"
                    xmlns:h="clr-namespace:Tessel.NET.Helpers">

    <!--  Borderless text box used inside AutoSuggestBox  -->
    <Style x:Key="Tessel.SuggestTextBox" TargetType="{x:Type TextBox}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CaretBrush" Value="{DynamicResource Tessel.TextBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Tessel.AccentBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <ScrollViewer x:Name="PART_ContentHost"
                                  Background="Transparent"
                                  Focusable="False"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Hidden" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Tessel.QueryButton" TargetType="{x:Type Button}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Width" Value="30" />
        <Setter Property="Foreground" Value="{DynamicResource Tessel.TextSecondaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Bd"
                            Margin="2"
                            Background="Transparent"
                            CornerRadius="{DynamicResource Tessel.SmallCornerRadius}">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="{DynamicResource Tessel.IconFontFamily}"
                                   FontSize="13"
                                   Foreground="{TemplateBinding Foreground}"
                                   Text="{TemplateBinding Content}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Tessel.ControlHoverBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource Tessel.TextBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Tessel.ControlPressedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  AutoSuggestBox  -->
    <Style TargetType="{x:Type c:AutoSuggestBox}">
        <Setter Property="Background" Value="{DynamicResource Tessel.InputBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource Tessel.TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Tessel.BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="FontFamily" Value="{DynamicResource Tessel.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Tessel.FontSize}" />
        <Setter Property="h:ControlHelper.CornerRadius" Value="{DynamicResource Tessel.ControlCornerRadius}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:AutoSuggestBox}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <ContentPresenter x:Name="Header"
                                          Margin="0,0,0,6"
                                          Content="{TemplateBinding h:ControlHelper.Header}"
                                          TextElement.Foreground="{DynamicResource Tessel.TextBrush}" />
                        <Border x:Name="Bd"
                                Grid.Row="1"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding h:ControlHelper.CornerRadius}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="PART_TextBox"
                                         Margin="{TemplateBinding Padding}"
                                         VerticalAlignment="Center"
                                         FontFamily="{TemplateBinding FontFamily}"
                                         FontSize="{TemplateBinding FontSize}"
                                         Foreground="{TemplateBinding Foreground}"
                                         Style="{StaticResource Tessel.SuggestTextBox}" />
                                <TextBlock x:Name="Placeholder"
                                           Margin="{TemplateBinding Padding}"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource Tessel.TextTertiaryBrush}"
                                           IsHitTestVisible="False"
                                           Text="{TemplateBinding PlaceholderText}"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="Collapsed" />
                                <Button x:Name="PART_QueryButton"
                                        Grid.Column="1"
                                        Content="{TemplateBinding QueryIcon}"
                                        Style="{StaticResource Tessel.QueryButton}" />
                            </Grid>
                        </Border>
                        <Popup x:Name="PART_Popup"
                               Grid.Row="1"
                               AllowsTransparency="True"
                               Focusable="False"
                               HorizontalOffset="0"
                               IsOpen="{Binding IsSuggestionListOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                               Placement="Bottom"
                               PlacementTarget="{Binding ElementName=Bd}"
                               PopupAnimation="Fade"
                               StaysOpen="False"
                               VerticalOffset="-4">
                            <Border Width="{Binding ActualWidth, ElementName=Bd}"
                                    Margin="8,4,8,12"
                                    Background="{DynamicResource Tessel.SurfaceBrush}"
                                    BorderBrush="{DynamicResource Tessel.BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource Tessel.OverlayCornerRadius}"
                                    Effect="{DynamicResource Tessel.Shadow}">
                                <ListBox x:Name="PART_SuggestionsList"
                                         MaxHeight="{TemplateBinding MaxSuggestionListHeight}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         DisplayMemberPath="{TemplateBinding DisplayMemberPath}"
                                         ItemTemplate="{TemplateBinding ItemTemplate}"
                                         ItemsSource="{Binding ItemsSource, RelativeSource={RelativeSource TemplatedParent}}"
                                         Padding="4"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="h:ControlHelper.Header" Value="{x:Null}">
                            <Setter TargetName="Header" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="QueryIcon" Value="">
                            <Setter TargetName="PART_QueryButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Tessel.BorderStrongBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Tessel.AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  TimePicker  -->
    <Style x:Key="Tessel.PickerToggle" TargetType="{x:Type ToggleButton}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="ClickMode" Value="Release" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding h:ControlHelper.CornerRadius}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Tessel.ControlHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Tessel.AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Tessel.AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="Tessel.PickerCell">
        <TextBlock HorizontalAlignment="Center" Text="{Binding}" />
    </DataTemplate>

    <Style TargetType="{x:Type c:TimePicker}">
        <Setter Property="Background" Value="{DynamicResource Tessel.ControlBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource Tessel.TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Tessel.BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="MinWidth" Value="140" />
        <Setter Property="FontFamily" Value="{DynamicResource Tessel.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Tessel.FontSize}" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="h:ControlHelper.CornerRadius" Value="{DynamicResource Tessel.ControlCornerRadius}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:TimePicker}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <ContentPresenter x:Name="Header"
                                          Margin="0,0,0,6"
                                          Content="{TemplateBinding h:ControlHelper.Header}"
                                          TextElement.Foreground="{DynamicResource Tessel.TextBrush}" />
                        <ToggleButton x:Name="Toggle"
                                      Grid.Row="1"
                                      h:ControlHelper.CornerRadius="{TemplateBinding h:ControlHelper.CornerRadius}"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      Padding="{TemplateBinding Padding}"
                                      Style="{StaticResource Tessel.PickerToggle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="Value"
                                           Foreground="{TemplateBinding Foreground}"
                                           Text="{TemplateBinding DisplayText}" />
                                <TextBlock x:Name="Placeholder"
                                           Foreground="{DynamicResource Tessel.TextTertiaryBrush}"
                                           Text="{TemplateBinding PlaceholderText}"
                                           Visibility="Collapsed" />
                                <TextBlock Grid.Column="1"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center"
                                           FontFamily="{DynamicResource Tessel.IconFontFamily}"
                                           FontSize="13"
                                           Foreground="{DynamicResource Tessel.TextSecondaryBrush}"
                                           Text="&#xE823;" />
                            </Grid>
                        </ToggleButton>
                        <Popup x:Name="PART_Popup"
                               Grid.Row="1"
                               AllowsTransparency="True"
                               Focusable="False"
                               HorizontalOffset="0"
                               IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                               Placement="Bottom"
                               PlacementTarget="{Binding ElementName=Toggle}"
                               PopupAnimation="Fade"
                               StaysOpen="False"
                               VerticalOffset="-4">
                            <Border Margin="8,4,8,12"
                                    Background="{DynamicResource Tessel.SurfaceBrush}"
                                    BorderBrush="{DynamicResource Tessel.BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource Tessel.OverlayCornerRadius}"
                                    Effect="{DynamicResource Tessel.Shadow}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Margin="6" Orientation="Horizontal">
                                        <ListBox x:Name="PART_HourList"
                                                 Width="64"
                                                 Height="220"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 ItemTemplate="{StaticResource Tessel.PickerCell}"
                                                 Padding="2" />
                                        <ListBox x:Name="PART_MinuteList"
                                                 Width="64"
                                                 Height="220"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 ItemTemplate="{StaticResource Tessel.PickerCell}"
                                                 Padding="2" />
                                        <ListBox x:Name="PART_PeriodList"
                                                 Width="64"
                                                 Height="220"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 ItemTemplate="{StaticResource Tessel.PickerCell}"
                                                 Padding="2" />
                                    </StackPanel>
                                    <Border Grid.Row="1"
                                            Padding="8"
                                            Background="{DynamicResource Tessel.SurfaceAltBrush}"
                                            BorderBrush="{DynamicResource Tessel.BorderBrush}"
                                            BorderThickness="0,1,0,0"
                                            CornerRadius="0,0,8,8">
                                        <UniformGrid Rows="1">
                                            <Button x:Name="PART_AcceptButton"
                                                    Margin="2"
                                                    Content="&#xE73E;"
                                                    FontFamily="{DynamicResource Tessel.IconFontFamily}"
                                                    Style="{DynamicResource Tessel.Button.Accent}" />
                                            <Button x:Name="PART_CancelButton"
                                                    Margin="2"
                                                    Content="&#xE711;"
                                                    FontFamily="{DynamicResource Tessel.IconFontFamily}" />
                                        </UniformGrid>
                                    </Border>
                                </Grid>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="h:ControlHelper.Header" Value="{x:Null}">
                            <Setter TargetName="Header" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="DisplayText" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Value" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
