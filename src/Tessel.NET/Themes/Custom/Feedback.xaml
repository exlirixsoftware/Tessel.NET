<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Tessel.NET.Controls">

    <Style x:Key="Tessel.SmallIconButton" TargetType="{x:Type ButtonBase}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Tessel.TextSecondaryBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource Tessel.IconFontFamily}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ButtonBase}">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource Tessel.SmallCornerRadius}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Tessel.ControlHoverBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource Tessel.TextBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Tessel.ControlPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  InfoBar  -->
    <Style TargetType="{x:Type c:InfoBar}">
        <Setter Property="Background" Value="{DynamicResource Tessel.InfoSubtleBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource Tessel.TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Tessel.BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16,12,12,12" />
        <Setter Property="FontFamily" Value="{DynamicResource Tessel.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Tessel.FontSize}" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:InfoBar}">
                    <Border Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource Tessel.OverlayCornerRadius}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="Icon"
                                       Margin="0,2,12,0"
                                       VerticalAlignment="Top"
                                       FontFamily="{DynamicResource Tessel.IconFontFamily}"
                                       FontSize="16"
                                       Foreground="{DynamicResource Tessel.InfoBrush}"
                                       Text="&#xE946;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="Title"
                                           FontWeight="SemiBold"
                                           Text="{TemplateBinding Title}"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="Message"
                                           Margin="0,2,0,0"
                                           Foreground="{DynamicResource Tessel.TextSecondaryBrush}"
                                           Text="{TemplateBinding Message}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <ContentPresenter x:Name="Action"
                                              Grid.Column="2"
                                              Margin="12,0,0,0"
                                              VerticalAlignment="Center" />
                            <Button x:Name="PART_CloseButton"
                                    Grid.Column="3"
                                    Margin="8,-4,-4,-4"
                                    VerticalAlignment="Top"
                                    Content="&#xE711;"
                                    Style="{StaticResource Tessel.SmallIconButton}"
                                    ToolTip="Close" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Severity" Value="Success">
                            <Setter TargetName="Icon" Property="Text" Value="&#xE930;" />
                            <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource Tessel.SuccessBrush}" />
                        </Trigger>
                        <Trigger Property="Severity" Value="Warning">
                            <Setter TargetName="Icon" Property="Text" Value="&#xE7BA;" />
                            <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource Tessel.WarningBrush}" />
                        </Trigger>
                        <Trigger Property="Severity" Value="Error">
                            <Setter TargetName="Icon" Property="Text" Value="&#xEA39;" />
                            <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource Tessel.DangerBrush}" />
                        </Trigger>
                        <Trigger Property="IsIconVisible" Value="False">
                            <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Title" Value="">
                            <Setter TargetName="Title" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Message" Value="">
                            <Setter TargetName="Message" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="HasContent" Value="False">
                            <Setter TargetName="Action" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsClosable" Value="False">
                            <Setter TargetName="PART_CloseButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Severity" Value="Success">
                <Setter Property="Background" Value="{DynamicResource Tessel.SuccessSubtleBrush}" />
            </Trigger>
            <Trigger Property="Severity" Value="Warning">
                <Setter Property="Background" Value="{DynamicResource Tessel.WarningSubtleBrush}" />
            </Trigger>
            <Trigger Property="Severity" Value="Error">
                <Setter Property="Background" Value="{DynamicResource Tessel.DangerSubtleBrush}" />
            </Trigger>
            <Trigger Property="IsOpen" Value="False">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--  ContentDialog  -->
    <Style TargetType="{x:Type c:ContentDialog}">
        <Setter Property="Background" Value="{DynamicResource Tessel.SurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource Tessel.TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Tessel.BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="24" />
        <Setter Property="FontFamily" Value="{DynamicResource Tessel.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Tessel.FontSize}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="Cycle" />
        <Setter Property="KeyboardNavigation.ControlTabNavigation" Value="Cycle" />
        <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Contained" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:ContentDialog}">
                    <Grid Background="{DynamicResource Tessel.OverlayBrush}">
                        <Border x:Name="PART_Dialog"
                                MinWidth="320"
                                MaxWidth="548"
                                Margin="24"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource Tessel.OverlayCornerRadius}"
                                Effect="{DynamicResource Tessel.ShadowLarge}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Margin="{TemplateBinding Padding}">
                                    <ContentPresenter x:Name="Title"
                                                      Margin="0,0,0,12"
                                                      Content="{TemplateBinding Title}"
                                                      TextElement.FontSize="20"
                                                      TextElement.FontWeight="SemiBold" />
                                    <ContentPresenter>
                                        <ContentPresenter.Resources>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="TextWrapping" Value="Wrap" />
                                            </Style>
                                        </ContentPresenter.Resources>
                                    </ContentPresenter>
                                </StackPanel>
                                <Border Grid.Row="1"
                                        Padding="20,16"
                                        Background="{DynamicResource Tessel.SurfaceAltBrush}"
                                        BorderBrush="{DynamicResource Tessel.BorderBrush}"
                                        BorderThickness="0,1,0,0"
                                        CornerRadius="0,0,8,8">
                                    <UniformGrid Rows="1">
                                        <Button x:Name="PART_PrimaryButton"
                                                Margin="4,0"
                                                HorizontalAlignment="Stretch"
                                                Content="{TemplateBinding PrimaryButtonText}"
                                                IsEnabled="{TemplateBinding IsPrimaryButtonEnabled}"
                                                Style="{DynamicResource Tessel.Button.Accent}" />
                                        <Button x:Name="PART_SecondaryButton"
                                                Margin="4,0"
                                                HorizontalAlignment="Stretch"
                                                Content="{TemplateBinding SecondaryButtonText}" />
                                        <Button x:Name="PART_CloseButton"
                                                Margin="4,0"
                                                HorizontalAlignment="Stretch"
                                                Content="{TemplateBinding CloseButtonText}" />
                                    </UniformGrid>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Title" Value="{x:Null}">
                            <Setter TargetName="Title" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsPrimaryDestructive" Value="True">
                            <Setter TargetName="PART_PrimaryButton" Property="Style" Value="{DynamicResource Tessel.Button.Danger}" />
                        </Trigger>
                        <Trigger Property="PrimaryButtonText" Value="">
                            <Setter TargetName="PART_PrimaryButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="SecondaryButtonText" Value="">
                            <Setter TargetName="PART_SecondaryButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="CloseButtonText" Value="">
                            <Setter TargetName="PART_CloseButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
