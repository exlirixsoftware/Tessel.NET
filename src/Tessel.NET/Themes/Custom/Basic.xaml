<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Tessel.NET.Controls">

    <!--  Card  -->
    <Style TargetType="{x:Type c:Card}">
        <Setter Property="Background" Value="{DynamicResource Tessel.SurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource Tessel.TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Tessel.BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:Card}">
                    <Border x:Name="Bd"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            SnapsToDevicePixels="True">
                        <DockPanel>
                            <ContentPresenter x:Name="Header"
                                              Margin="0,0,0,14"
                                              ContentSource="Header"
                                              DockPanel.Dock="Top"
                                              TextElement.FontSize="16"
                                              TextElement.FontWeight="SemiBold" />
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasHeader" Value="False">
                            <Setter TargetName="Header" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsElevated" Value="True">
                            <Setter TargetName="Bd" Property="Effect" Value="{DynamicResource Tessel.Shadow}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Badge  -->
    <Style TargetType="{x:Type c:Badge}">
        <Setter Property="Background" Value="{DynamicResource Tessel.SubtleBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource Tessel.TextSecondaryBrush}" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="FontSize" Value="{DynamicResource Tessel.FontSizeSmall}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:Badge}">
                    <Border Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="10"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Kind" Value="Accent">
                <Setter Property="Background" Value="{DynamicResource Tessel.AccentSubtleBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource Tessel.AccentBrush}" />
            </Trigger>
            <Trigger Property="Kind" Value="Success">
                <Setter Property="Background" Value="{DynamicResource Tessel.SuccessSubtleBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource Tessel.SuccessBrush}" />
            </Trigger>
            <Trigger Property="Kind" Value="Warning">
                <Setter Property="Background" Value="{DynamicResource Tessel.WarningSubtleBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource Tessel.WarningBrush}" />
            </Trigger>
            <Trigger Property="Kind" Value="Danger">
                <Setter Property="Background" Value="{DynamicResource Tessel.DangerSubtleBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource Tessel.DangerBrush}" />
            </Trigger>
            <Trigger Property="Kind" Value="Info">
                <Setter Property="Background" Value="{DynamicResource Tessel.InfoSubtleBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource Tessel.InfoBrush}" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsSolid" Value="True" />
                    <Condition Property="Kind" Value="Neutral" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource Tessel.TextSecondaryBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource Tessel.SurfaceBrush}" />
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsSolid" Value="True" />
                    <Condition Property="Kind" Value="Accent" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource Tessel.AccentBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource Tessel.OnAccentBrush}" />
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsSolid" Value="True" />
                    <Condition Property="Kind" Value="Success" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource Tessel.SuccessBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource Tessel.SurfaceBrush}" />
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsSolid" Value="True" />
                    <Condition Property="Kind" Value="Warning" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource Tessel.WarningBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource Tessel.SurfaceBrush}" />
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsSolid" Value="True" />
                    <Condition Property="Kind" Value="Danger" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource Tessel.DangerBrush}" />
                <Setter Property="Foreground" Value="White" />
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsSolid" Value="True" />
                    <Condition Property="Kind" Value="Info" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource Tessel.InfoBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource Tessel.SurfaceBrush}" />
            </MultiTrigger>
        </Style.Triggers>
    </Style>

    <!--  FontIcon  -->
    <Style TargetType="{x:Type c:FontIcon}">
        <Setter Property="FontFamily" Value="{DynamicResource Tessel.IconFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Tessel.IconSize}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:FontIcon}">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontFamily="{TemplateBinding FontFamily}"
                               FontSize="{TemplateBinding FontSize}"
                               Foreground="{TemplateBinding Foreground}"
                               Text="{TemplateBinding Glyph}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ToggleSwitch  -->
    <Style TargetType="{x:Type c:ToggleSwitch}">
        <Setter Property="Foreground" Value="{DynamicResource Tessel.TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource Tessel.InputBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Tessel.TextSecondaryBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource Tessel.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Tessel.FontSize}" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource Tessel.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:ToggleSwitch}">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Track"
                                Width="40"
                                Height="20"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1.5"
                                CornerRadius="10">
                            <Ellipse x:Name="Knob"
                                     Width="12"
                                     Height="12"
                                     Margin="3.5,0,0,0"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Center"
                                     Fill="{DynamicResource Tessel.TextSecondaryBrush}">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform X="0" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Border>
                        <ContentPresenter x:Name="ContentHost"
                                          Grid.Column="1"
                                          Margin="12,0,0,0"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Content="{TemplateBinding OffContent}"
                                          RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="OffContent" Value="{x:Null}">
                            <Setter TargetName="ContentHost" Property="Content" Value="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Tessel.ControlHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Tessel.AccentBrush}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Tessel.AccentBrush}" />
                            <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource Tessel.OnAccentBrush}" />
                            <Setter TargetName="ContentHost" Property="Content" Value="{Binding OnContent, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Knob"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                         To="18"
                                                         Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Knob"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                         To="0"
                                                         Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True" />
                                <Condition Property="OnContent" Value="{x:Null}" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="ContentHost" Property="Content" Value="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Tessel.AccentHoverBrush}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Tessel.AccentHoverBrush}" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ProgressRing  -->
    <Style TargetType="{x:Type c:ProgressRing}">
        <Setter Property="Foreground" Value="{DynamicResource Tessel.AccentBrush}" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:ProgressRing}">
                    <Grid x:Name="Root" Visibility="Hidden">
                        <Ellipse x:Name="Track"
                                 Stroke="{DynamicResource Tessel.SubtleBrush}"
                                 StrokeThickness="{TemplateBinding Thickness}"
                                 Visibility="Collapsed" />
                        <Ellipse x:Name="PART_Arc"
                                 RenderTransformOrigin="0.5,0.5"
                                 Stroke="{TemplateBinding Foreground}"
                                 StrokeDashCap="Round"
                                 StrokeEndLineCap="Round"
                                 StrokeStartLineCap="Round"
                                 StrokeThickness="{TemplateBinding Thickness}">
                            <Ellipse.RenderTransform>
                                <RotateTransform Angle="0" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsActive" Value="True">
                            <Setter TargetName="Root" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsIndeterminate" Value="False">
                            <Setter TargetName="Track" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PART_Arc" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="-90" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsActive" Value="True" />
                                <Condition Property="IsIndeterminate" Value="True" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard x:Name="SpinStoryboard">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="PART_Arc"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                         From="0"
                                                         To="360"
                                                         Duration="0:0:0.9" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="SpinStoryboard" />
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Avatar  -->
    <Style TargetType="{x:Type c:Avatar}">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:Avatar}">
                    <Grid>
                        <Ellipse x:Name="Circle" Fill="{TemplateBinding Fill}" />
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="{TemplateBinding FontSize}"
                                   FontWeight="{TemplateBinding FontWeight}"
                                   Foreground="{TemplateBinding Foreground}"
                                   Text="{TemplateBinding Initials}" />
                        <Ellipse x:Name="PART_Image" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Fill" Value="{x:Null}">
                            <Setter TargetName="Circle" Property="Fill" Value="{DynamicResource Tessel.AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  SettingsCard  -->
    <Style TargetType="{x:Type c:SettingsCard}">
        <Setter Property="Background" Value="{DynamicResource Tessel.SurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource Tessel.TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Tessel.BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="MinHeight" Value="68" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:SettingsCard}">
                    <Border Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource Tessel.OverlayCornerRadius}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter x:Name="Icon"
                                              Margin="4,0,16,0"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding Icon}"
                                              TextElement.FontFamily="{DynamicResource Tessel.IconFontFamily}"
                                              TextElement.FontSize="20" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <ContentPresenter Content="{TemplateBinding Header}" />
                                <ContentPresenter x:Name="Description"
                                                  Margin="0,2,0,0"
                                                  Content="{TemplateBinding Description}"
                                                  TextElement.FontSize="{DynamicResource Tessel.FontSizeSmall}"
                                                  TextElement.Foreground="{DynamicResource Tessel.TextSecondaryBrush}" />
                            </StackPanel>
                            <ContentPresenter Grid.Column="2"
                                              Margin="16,0,0,0"
                                              VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Description" Value="{x:Null}">
                            <Setter TargetName="Description" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
