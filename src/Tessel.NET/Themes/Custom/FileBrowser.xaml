<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Tessel.NET.Controls"
                    xmlns:h="clr-namespace:Tessel.NET.Helpers">

    <!--  Borderless text box used to edit the path  -->
    <Style x:Key="Tessel.PathTextBox" TargetType="{x:Type TextBox}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CaretBrush" Value="{DynamicResource Tessel.TextBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Tessel.AccentBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <ScrollViewer x:Name="PART_ContentHost"
                                  Background="Transparent"
                                  Focusable="False"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Hidden" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="Tessel.FilePlaceTemplate" DataType="{x:Type c:FilePlace}">
        <StackPanel Orientation="Horizontal">
            <TextBlock Width="22"
                       Margin="0,0,8,0"
                       VerticalAlignment="Center"
                       FontFamily="{DynamicResource Tessel.IconFontFamily}"
                       FontSize="15"
                       Foreground="{DynamicResource Tessel.AccentBrush}"
                       Text="{Binding Glyph}" />
            <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="Tessel.FileNameCell" DataType="{x:Type c:FileEntry}">
        <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="Glyph"
                       Width="22"
                       Margin="0,0,8,0"
                       VerticalAlignment="Center"
                       FontFamily="{DynamicResource Tessel.IconFontFamily}"
                       FontSize="15"
                       Foreground="{DynamicResource Tessel.TextSecondaryBrush}"
                       Text="{Binding Glyph}" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock MaxWidth="216"
                           Text="{Binding Name}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding FullPath}" />
                <TextBlock x:Name="Location"
                           MaxWidth="216"
                           Foreground="{DynamicResource Tessel.TextTertiaryBrush}"
                           FontSize="{DynamicResource Tessel.FontSizeSmall}"
                           Text="{Binding Location}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Location}" Value="">
                <Setter TargetName="Location" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Tessel.AccentBrush}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!--  Thumbnails view: image preview (or a large icon) above the name  -->
    <DataTemplate x:Key="Tessel.FileThumbnailTemplate" DataType="{x:Type c:FileEntry}">
        <StackPanel Width="100" ToolTip="{Binding FullPath}">
            <Grid Width="92"
                  Height="68"
                  HorizontalAlignment="Center">
                <Border Background="{DynamicResource Tessel.SubtleBrush}" CornerRadius="6" />
                <Image Margin="3"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Source="{Binding Thumbnail}"
                       Stretch="Uniform" />
                <TextBlock x:Name="BigGlyph"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontFamily="{DynamicResource Tessel.IconFontFamily}"
                           FontSize="32"
                           Foreground="{DynamicResource Tessel.TextSecondaryBrush}"
                           Text="{Binding Glyph}"
                           Visibility="Collapsed" />
            </Grid>
            <TextBlock MaxHeight="36"
                       Margin="0,6,0,0"
                       FontSize="{DynamicResource Tessel.FontSizeSmall}"
                       Text="{Binding Name}"
                       TextAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="Wrap" />
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Thumbnail}" Value="{x:Null}">
                <Setter TargetName="BigGlyph" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                <Setter TargetName="BigGlyph" Property="Foreground" Value="{DynamicResource Tessel.AccentBrush}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <ItemsPanelTemplate x:Key="Tessel.FileThumbnailsPanel">
        <WrapPanel />
    </ItemsPanelTemplate>

    <DataTemplate x:Key="Tessel.FileSizeCell" DataType="{x:Type c:FileEntry}">
        <TextBlock HorizontalAlignment="Right"
                   Foreground="{DynamicResource Tessel.TextSecondaryBrush}"
                   Text="{Binding SizeText}" />
    </DataTemplate>

    <Style TargetType="{x:Type c:FileBrowser}">
        <Setter Property="Background" Value="{DynamicResource Tessel.SurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource Tessel.TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Tessel.BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="MinHeight" Value="280" />
        <Setter Property="MinWidth" Value="600" />
        <Setter Property="FontFamily" Value="{DynamicResource Tessel.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Tessel.FontSize}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:FileBrowser}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource Tessel.OverlayCornerRadius}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!--  Navigation bar  -->
                            <Grid Margin="8,8,8,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="PART_BackButton"
                                        Content="&#xE72B;"
                                        IsEnabled="{TemplateBinding CanGoBack}"
                                        Style="{DynamicResource Tessel.Button.Icon}"
                                        ToolTip="Back (Alt+Left)" />
                                <Button x:Name="PART_ForwardButton"
                                        Grid.Column="1"
                                        Content="&#xE72A;"
                                        IsEnabled="{TemplateBinding CanGoForward}"
                                        Style="{DynamicResource Tessel.Button.Icon}"
                                        ToolTip="Forward (Alt+Right)" />
                                <Button x:Name="PART_UpButton"
                                        Grid.Column="2"
                                        Content="&#xE74A;"
                                        IsEnabled="{TemplateBinding CanGoUp}"
                                        Style="{DynamicResource Tessel.Button.Icon}"
                                        ToolTip="Up one level (Alt+Up)" />
                                <Button x:Name="PART_RefreshButton"
                                        Grid.Column="3"
                                        Content="&#xE72C;"
                                        Style="{DynamicResource Tessel.Button.Icon}"
                                        ToolTip="Refresh (F5)" />
                                <Border x:Name="PART_PathHost"
                                        Grid.Column="4"
                                        Height="32"
                                        Margin="6,0,8,0"
                                        Background="{DynamicResource Tessel.InputBackgroundBrush}"
                                        BorderBrush="{DynamicResource Tessel.BorderBrush}"
                                        BorderThickness="1"
                                        Cursor="IBeam"
                                        CornerRadius="{DynamicResource Tessel.ControlCornerRadius}">
                                    <Grid Margin="6,0">
                                        <ScrollViewer x:Name="PART_BreadcrumbScroller"
                                                      Focusable="False"
                                                      HorizontalScrollBarVisibility="Hidden"
                                                      VerticalScrollBarVisibility="Disabled">
                                            <c:BreadcrumbBar x:Name="PART_Breadcrumb"
                                                             VerticalAlignment="Center"
                                                             DisplayMemberPath="Name"
                                                             ItemsSource="{Binding PathSegments, RelativeSource={RelativeSource TemplatedParent}}" />
                                        </ScrollViewer>
                                        <TextBox x:Name="PART_PathBox"
                                                 Margin="6,0"
                                                 VerticalAlignment="Center"
                                                 Style="{StaticResource Tessel.PathTextBox}"
                                                 Visibility="Collapsed" />
                                    </Grid>
                                </Border>
                                <TextBox x:Name="PART_SearchBox"
                                         Grid.Column="5"
                                         Width="190"
                                         Margin="0,0,8,0"
                                         h:ControlHelper.Icon="&#xE721;"
                                         h:ControlHelper.PlaceholderText="Search"
                                         h:ControlHelper.ShowClearButton="True"
                                         Text="{Binding SearchText, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Search this folder and its subfolders (Ctrl+F)" />
                                <c:SegmentedControl x:Name="PART_ViewSwitch"
                                                    Grid.Column="6"
                                                    Margin="0,0,8,0"
                                                    VerticalAlignment="Center"
                                                    SelectedIndex="0">
                                    <c:SegmentedItem MinWidth="36"
                                                     Padding="0"
                                                     Content="&#xEA37;"
                                                     FontFamily="{DynamicResource Tessel.IconFontFamily}"
                                                     ToolTip="Details" />
                                    <c:SegmentedItem MinWidth="36"
                                                     Padding="0"
                                                     Content="&#xE91B;"
                                                     FontFamily="{DynamicResource Tessel.IconFontFamily}"
                                                     ToolTip="Thumbnails" />
                                </c:SegmentedControl>
                                <Button x:Name="PART_NewFolderButton"
                                        Grid.Column="7"
                                        Content="&#xE8F4;"
                                        Style="{DynamicResource Tessel.Button.Icon}"
                                        ToolTip="New folder" />
                            </Grid>

                            <!--  Places and files  -->
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="188" />
                                    <ColumnDefinition Width="1" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ListBox x:Name="PART_PlacesList"
                                         Padding="6,2"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         ItemTemplate="{StaticResource Tessel.FilePlaceTemplate}"
                                         ItemsSource="{Binding Places, RelativeSource={RelativeSource TemplatedParent}}" />
                                <Border Grid.Column="1" Background="{DynamicResource Tessel.BorderBrush}" />
                                <Grid Grid.Column="2">
                                    <ListView x:Name="PART_FileList"
                                              Padding="4,0,4,4"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              ItemsSource="{Binding Entries, RelativeSource={RelativeSource TemplatedParent}}">
                                        <ListView.View>
                                            <GridView AllowsColumnReorder="False">
                                                <GridViewColumn Width="264"
                                                                CellTemplate="{StaticResource Tessel.FileNameCell}"
                                                                Header="Name" />
                                                <GridViewColumn Width="140"
                                                                DisplayMemberBinding="{Binding ModifiedText}"
                                                                Header="Date modified" />
                                                <GridViewColumn Width="100"
                                                                DisplayMemberBinding="{Binding TypeName}"
                                                                Header="Type" />
                                                <GridViewColumn Width="78"
                                                                CellTemplate="{StaticResource Tessel.FileSizeCell}"
                                                                Header="Size" />
                                            </GridView>
                                        </ListView.View>
                                    </ListView>
                                    <TextBlock x:Name="StatusOverlay"
                                               Margin="24,64,24,0"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Top"
                                               Foreground="{DynamicResource Tessel.TextSecondaryBrush}"
                                               IsHitTestVisible="False"
                                               Text="{TemplateBinding StatusText}"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap" />
                                    <c:ProgressRing Width="22"
                                                    Height="22"
                                                    Margin="0,56,0,0"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Top"
                                                    IsActive="{TemplateBinding IsLoading}"
                                                    Thickness="2.5" />
                                </Grid>
                            </Grid>

                            <!--  Status bar  -->
                            <Border Grid.Row="2"
                                    Padding="12,6"
                                    Background="{DynamicResource Tessel.SurfaceAltBrush}"
                                    BorderBrush="{DynamicResource Tessel.BorderBrush}"
                                    BorderThickness="0,1,0,0"
                                    CornerRadius="0,0,8,8">
                                <TextBlock FontSize="{DynamicResource Tessel.FontSizeSmall}"
                                           Foreground="{DynamicResource Tessel.TextSecondaryBrush}"
                                           Text="{TemplateBinding SummaryText}" />
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="StatusText" Value="">
                            <Setter TargetName="StatusOverlay" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="AllowNewFolder" Value="False">
                            <Setter TargetName="PART_NewFolderButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="ViewMode" Value="Thumbnails">
                            <Setter TargetName="PART_FileList" Property="View" Value="{x:Null}" />
                            <Setter TargetName="PART_FileList" Property="ItemTemplate" Value="{StaticResource Tessel.FileThumbnailTemplate}" />
                            <Setter TargetName="PART_FileList" Property="ItemsPanel" Value="{StaticResource Tessel.FileThumbnailsPanel}" />
                            <Setter TargetName="PART_FileList" Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                        </Trigger>
                        <Trigger Property="IsEditingPath" Value="True">
                            <Setter TargetName="PART_BreadcrumbScroller" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_PathBox" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PART_PathHost" Property="BorderBrush" Value="{DynamicResource Tessel.AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
