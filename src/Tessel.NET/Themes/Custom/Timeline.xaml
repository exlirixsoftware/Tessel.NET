<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Tessel.NET.Controls">

    <!--
        Vertical entry: [timestamp | marker + line | content]. The timestamp column is shared by all entries
        (Grid.IsSharedSizeScope on the Timeline) so markers line up. In the alternate layout both outer columns are equal.
    -->
    <ControlTemplate x:Key="Tessel.TimelineItem.Vertical" TargetType="{x:Type c:TimelineItem}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="BeforeColumn" Width="Auto" SharedSizeGroup="TimelineBefore" />
                <ColumnDefinition Width="40" />
                <ColumnDefinition x:Name="AfterColumn" Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition x:Name="SpacerRow" Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Marker and connecting line  -->
            <Grid Grid.Column="1" Grid.RowSpan="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="4" />
                    <RowDefinition Height="28" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Rectangle x:Name="LineTop"
                           Width="2"
                           HorizontalAlignment="Center"
                           Fill="{DynamicResource Tessel.BorderStrongBrush}" />
                <Grid Grid.Row="1" Width="28" Height="28">
                    <Ellipse x:Name="Ring"
                             Fill="{DynamicResource Tessel.SurfaceBrush}"
                             Stroke="{TemplateBinding MarkerBrush}"
                             StrokeThickness="2" />
                    <Ellipse x:Name="Filled" Fill="{TemplateBinding MarkerBrush}" />
                    <Ellipse x:Name="Dot"
                             Width="8"
                             Height="8"
                             Fill="{TemplateBinding MarkerBrush}"
                             Visibility="Collapsed" />
                    <ContentPresenter x:Name="IconHost"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Content="{TemplateBinding Icon}"
                                      TextElement.FontFamily="{DynamicResource Tessel.IconFontFamily}"
                                      TextElement.FontSize="13"
                                      TextElement.Foreground="White" />
                </Grid>
                <Rectangle x:Name="LineBottom"
                           Grid.Row="2"
                           Width="2"
                           HorizontalAlignment="Center"
                           Fill="{DynamicResource Tessel.BorderStrongBrush}" />
            </Grid>

            <!--  Timestamp (opposite side of the content)  -->
            <ContentPresenter x:Name="TimestampHost"
                              Margin="0,5,14,0"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Top"
                              Content="{TemplateBinding Timestamp}"
                              ContentStringFormat="{TemplateBinding TimestampStringFormat}"
                              TextElement.FontSize="{DynamicResource Tessel.FontSizeSmall}"
                              TextElement.Foreground="{DynamicResource Tessel.TextSecondaryBrush}" />

            <!--  Content  -->
            <StackPanel x:Name="ContentHost"
                        Grid.Column="2"
                        Margin="14,4,0,0">
                <ContentPresenter x:Name="HeaderHost"
                                  Content="{TemplateBinding Header}"
                                  TextElement.FontWeight="SemiBold">
                    <ContentPresenter.Resources>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="TextWrapping" Value="Wrap" />
                        </Style>
                    </ContentPresenter.Resources>
                </ContentPresenter>
                <ContentPresenter x:Name="BodyHost"
                                  Margin="0,2,0,0"
                                  TextElement.Foreground="{DynamicResource Tessel.TextSecondaryBrush}">
                    <ContentPresenter.Resources>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="TextWrapping" Value="Wrap" />
                        </Style>
                    </ContentPresenter.Resources>
                </ContentPresenter>
            </StackPanel>

            <Border x:Name="Spacer"
                    Grid.Row="1"
                    Grid.Column="2"
                    Height="22" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsFirst" Value="True">
                <Setter TargetName="LineTop" Property="Visibility" Value="Hidden" />
            </Trigger>
            <Trigger Property="IsLast" Value="True">
                <Setter TargetName="LineBottom" Property="Visibility" Value="Hidden" />
                <Setter TargetName="Spacer" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Timestamp" Value="{x:Null}">
                <Setter TargetName="TimestampHost" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Header" Value="{x:Null}">
                <Setter TargetName="HeaderHost" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="HasContent" Value="False">
                <Setter TargetName="BodyHost" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter TargetName="Filled" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="IconHost" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="Kind" Value="Accent">
                <Setter TargetName="IconHost" Property="TextElement.Foreground" Value="{DynamicResource Tessel.OnAccentBrush}" />
            </Trigger>
            <Trigger Property="IsPending" Value="True">
                <Setter TargetName="Filled" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Dot" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="IconHost" Property="TextElement.Foreground" Value="{Binding MarkerBrush, RelativeSource={RelativeSource TemplatedParent}}" />
                <Setter TargetName="Ring" Property="StrokeDashArray" Value="2 1.5" />
                <Setter TargetName="LineBottom" Property="Opacity" Value="0.45" />
                <Setter TargetName="LineTop" Property="Opacity" Value="0.45" />
                <Setter TargetName="HeaderHost" Property="TextElement.Foreground" Value="{DynamicResource Tessel.TextSecondaryBrush}" />
            </Trigger>
            <Trigger Property="Layout" Value="Alternate">
                <Setter TargetName="BeforeColumn" Property="Width" Value="*" />
                <Setter TargetName="BeforeColumn" Property="SharedSizeGroup" Value="{x:Null}" />
            </Trigger>
            <Trigger Property="Side" Value="Start">
                <Setter TargetName="ContentHost" Property="Grid.Column" Value="0" />
                <Setter TargetName="ContentHost" Property="Margin" Value="0,4,14,0" />
                <Setter TargetName="ContentHost" Property="HorizontalAlignment" Value="Right" />
                <Setter TargetName="ContentHost" Property="TextBlock.TextAlignment" Value="Right" />
                <Setter TargetName="Spacer" Property="Grid.Column" Value="0" />
                <Setter TargetName="TimestampHost" Property="Grid.Column" Value="2" />
                <Setter TargetName="TimestampHost" Property="Margin" Value="14,5,0,0" />
                <Setter TargetName="TimestampHost" Property="HorizontalAlignment" Value="Left" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!--  Horizontal entry: timestamp / content above or below a marker on a horizontal line.  -->
    <ControlTemplate x:Key="Tessel.TimelineItem.Horizontal" TargetType="{x:Type c:TimelineItem}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" SharedSizeGroup="TimelineAbove" />
                <RowDefinition Height="28" />
                <RowDefinition Height="Auto" SharedSizeGroup="TimelineBelow" />
            </Grid.RowDefinitions>

            <!--  Marker and connecting line  -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Rectangle x:Name="LineLeft"
                           Height="2"
                           VerticalAlignment="Center"
                           Fill="{DynamicResource Tessel.BorderStrongBrush}" />
                <Grid Grid.Column="1" Width="28" Height="28">
                    <Ellipse x:Name="Ring"
                             Fill="{DynamicResource Tessel.SurfaceBrush}"
                             Stroke="{TemplateBinding MarkerBrush}"
                             StrokeThickness="2" />
                    <Ellipse x:Name="Filled" Fill="{TemplateBinding MarkerBrush}" />
                    <Ellipse x:Name="Dot"
                             Width="8"
                             Height="8"
                             Fill="{TemplateBinding MarkerBrush}"
                             Visibility="Collapsed" />
                    <ContentPresenter x:Name="IconHost"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Content="{TemplateBinding Icon}"
                                      TextElement.FontFamily="{DynamicResource Tessel.IconFontFamily}"
                                      TextElement.FontSize="13"
                                      TextElement.Foreground="White" />
                </Grid>
                <Rectangle x:Name="LineRight"
                           Grid.Column="2"
                           Height="2"
                           VerticalAlignment="Center"
                           Fill="{DynamicResource Tessel.BorderStrongBrush}" />
            </Grid>

            <!--  Content (below the line by default)  -->
            <StackPanel x:Name="ContentHost"
                        Grid.Row="2"
                        Margin="10,10,10,0"
                        TextBlock.TextAlignment="Center">
                <ContentPresenter x:Name="HeaderHost"
                                  Content="{TemplateBinding Header}"
                                  TextElement.FontWeight="SemiBold">
                    <ContentPresenter.Resources>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="TextWrapping" Value="Wrap" />
                        </Style>
                    </ContentPresenter.Resources>
                </ContentPresenter>
                <ContentPresenter x:Name="BodyHost"
                                  Margin="0,2,0,0"
                                  TextElement.Foreground="{DynamicResource Tessel.TextSecondaryBrush}">
                    <ContentPresenter.Resources>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="TextWrapping" Value="Wrap" />
                        </Style>
                    </ContentPresenter.Resources>
                </ContentPresenter>
            </StackPanel>

            <!--  Timestamp (above the line by default)  -->
            <ContentPresenter x:Name="TimestampHost"
                              Margin="10,0,10,10"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Bottom"
                              Content="{TemplateBinding Timestamp}"
                              ContentStringFormat="{TemplateBinding TimestampStringFormat}"
                              TextElement.FontSize="{DynamicResource Tessel.FontSizeSmall}"
                              TextElement.Foreground="{DynamicResource Tessel.TextSecondaryBrush}" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsFirst" Value="True">
                <Setter TargetName="LineLeft" Property="Visibility" Value="Hidden" />
            </Trigger>
            <Trigger Property="IsLast" Value="True">
                <Setter TargetName="LineRight" Property="Visibility" Value="Hidden" />
            </Trigger>
            <Trigger Property="Timestamp" Value="{x:Null}">
                <Setter TargetName="TimestampHost" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Header" Value="{x:Null}">
                <Setter TargetName="HeaderHost" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="HasContent" Value="False">
                <Setter TargetName="BodyHost" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter TargetName="Filled" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="IconHost" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="Kind" Value="Accent">
                <Setter TargetName="IconHost" Property="TextElement.Foreground" Value="{DynamicResource Tessel.OnAccentBrush}" />
            </Trigger>
            <Trigger Property="IsPending" Value="True">
                <Setter TargetName="Filled" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Dot" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="IconHost" Property="TextElement.Foreground" Value="{Binding MarkerBrush, RelativeSource={RelativeSource TemplatedParent}}" />
                <Setter TargetName="Ring" Property="StrokeDashArray" Value="2 1.5" />
                <Setter TargetName="LineLeft" Property="Opacity" Value="0.45" />
                <Setter TargetName="LineRight" Property="Opacity" Value="0.45" />
                <Setter TargetName="HeaderHost" Property="TextElement.Foreground" Value="{DynamicResource Tessel.TextSecondaryBrush}" />
            </Trigger>
            <Trigger Property="Side" Value="Start">
                <Setter TargetName="ContentHost" Property="Grid.Row" Value="0" />
                <Setter TargetName="ContentHost" Property="Margin" Value="10,0,10,10" />
                <Setter TargetName="ContentHost" Property="VerticalAlignment" Value="Bottom" />
                <Setter TargetName="TimestampHost" Property="Grid.Row" Value="2" />
                <Setter TargetName="TimestampHost" Property="Margin" Value="10,10,10,0" />
                <Setter TargetName="TimestampHost" Property="VerticalAlignment" Value="Top" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type c:TimelineItem}">
        <Setter Property="Foreground" Value="{DynamicResource Tessel.TextBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource Tessel.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Tessel.FontSize}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="MarkerBrush" Value="{DynamicResource Tessel.AccentBrush}" />
        <Setter Property="Template" Value="{StaticResource Tessel.TimelineItem.Vertical}" />
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Template" Value="{StaticResource Tessel.TimelineItem.Horizontal}" />
                <Setter Property="VerticalAlignment" Value="Top" />
            </Trigger>
            <Trigger Property="Kind" Value="Neutral">
                <Setter Property="MarkerBrush" Value="{DynamicResource Tessel.TextSecondaryBrush}" />
            </Trigger>
            <Trigger Property="Kind" Value="Success">
                <Setter Property="MarkerBrush" Value="{DynamicResource Tessel.SuccessBrush}" />
            </Trigger>
            <Trigger Property="Kind" Value="Warning">
                <Setter Property="MarkerBrush" Value="{DynamicResource Tessel.WarningBrush}" />
            </Trigger>
            <Trigger Property="Kind" Value="Danger">
                <Setter Property="MarkerBrush" Value="{DynamicResource Tessel.DangerBrush}" />
            </Trigger>
            <Trigger Property="Kind" Value="Info">
                <Setter Property="MarkerBrush" Value="{DynamicResource Tessel.InfoBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--  Timeline  -->
    <ControlTemplate x:Key="Tessel.Timeline.Vertical" TargetType="{x:Type c:Timeline}">
        <Border Padding="{TemplateBinding Padding}"
                Background="{TemplateBinding Background}">
            <ItemsPresenter />
        </Border>
    </ControlTemplate>

    <ControlTemplate x:Key="Tessel.Timeline.Horizontal" TargetType="{x:Type c:Timeline}">
        <ScrollViewer x:Name="PART_Scroller"
                      Padding="{TemplateBinding Padding}"
                      Background="{TemplateBinding Background}"
                      Focusable="False"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled">
            <ItemsPresenter />
        </ScrollViewer>
    </ControlTemplate>

    <Style TargetType="{x:Type c:Timeline}">
        <Setter Property="Foreground" Value="{DynamicResource Tessel.TextBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource Tessel.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Tessel.FontSize}" />
        <!--  Must be set on the control itself: the entries are logical children of the Timeline, not of its template.  -->
        <Setter Property="Grid.IsSharedSizeScope" Value="True" />
        <Setter Property="Template" Value="{StaticResource Tessel.Timeline.Vertical}" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Vertical" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Template" Value="{StaticResource Tessel.Timeline.Horizontal}" />
                <Setter Property="ItemsPanel">
                    <Setter.Value>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
