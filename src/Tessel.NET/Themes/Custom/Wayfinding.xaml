<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Tessel.NET.Controls">

    <!--  BreadcrumbBar  -->
    <Style x:Key="Tessel.BreadcrumbButton" TargetType="{x:Type Button}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource Tessel.TextSecondaryBrush}" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource Tessel.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Bd"
                            Padding="8,4"
                            Background="Transparent"
                            CornerRadius="{DynamicResource Tessel.SmallCornerRadius}">
                        <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Tessel.ControlHoverBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource Tessel.TextBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Tessel.ControlPressedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type c:BreadcrumbBarItem}">
        <Setter Property="FontFamily" Value="{DynamicResource Tessel.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Tessel.FontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource Tessel.TextSecondaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:BreadcrumbBarItem}">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="PART_Button"
                                Foreground="{TemplateBinding Foreground}"
                                Style="{StaticResource Tessel.BreadcrumbButton}">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}" />
                        </Button>
                        <TextBlock x:Name="Chevron"
                                   Margin="2,1,2,0"
                                   VerticalAlignment="Center"
                                   FontFamily="{DynamicResource Tessel.IconFontFamily}"
                                   FontSize="10"
                                   Foreground="{DynamicResource Tessel.TextTertiaryBrush}"
                                   Text="&#xE76C;" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsLast" Value="True">
                            <Setter TargetName="Chevron" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_Button" Property="Foreground" Value="{DynamicResource Tessel.TextBrush}" />
                            <Setter TargetName="PART_Button" Property="FontWeight" Value="SemiBold" />
                            <Setter TargetName="PART_Button" Property="IsHitTestVisible" Value="False" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type c:BreadcrumbBar}">
        <Setter Property="Foreground" Value="{DynamicResource Tessel.TextSecondaryBrush}" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:BreadcrumbBar}">
                    <ItemsPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Pagination  -->
    <Style x:Key="Tessel.PageButton" TargetType="{x:Type Button}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource Tessel.TextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="MinWidth" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Margin" Value="2,0" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource Tessel.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource Tessel.ControlCornerRadius}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Tessel.ControlHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Tessel.ControlPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="Tessel.PageItemTemplate" DataType="{x:Type c:PaginationPage}">
        <Grid>
            <Button x:Name="PageButton"
                    Content="{Binding Text}"
                    Style="{StaticResource Tessel.PageButton}" />
            <TextBlock x:Name="Ellipsis"
                       MinWidth="34"
                       Margin="2,0"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource Tessel.TextTertiaryBrush}"
                       Text="…"
                       TextAlignment="Center"
                       Visibility="Collapsed" />
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsEllipsis}" Value="True">
                <Setter TargetName="PageButton" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Ellipsis" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                <Setter TargetName="PageButton" Property="Foreground" Value="{DynamicResource Tessel.AccentBrush}" />
                <Setter TargetName="PageButton" Property="FontWeight" Value="SemiBold" />
                <Setter TargetName="PageButton" Property="Background" Value="{DynamicResource Tessel.AccentSubtleBrush}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <Style TargetType="{x:Type c:Pagination}">
        <Setter Property="FontFamily" Value="{DynamicResource Tessel.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Tessel.FontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource Tessel.TextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:Pagination}">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="PART_PreviousButton"
                                Content="&#xE76B;"
                                FontFamily="{DynamicResource Tessel.IconFontFamily}"
                                FontSize="12"
                                IsEnabled="{TemplateBinding CanGoPrevious}"
                                Style="{StaticResource Tessel.PageButton}"
                                ToolTip="Previous page" />
                        <ItemsControl Focusable="False"
                                      ItemTemplate="{StaticResource Tessel.PageItemTemplate}"
                                      ItemsSource="{Binding Pages, RelativeSource={RelativeSource TemplatedParent}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <Button x:Name="PART_NextButton"
                                Content="&#xE76C;"
                                FontFamily="{DynamicResource Tessel.IconFontFamily}"
                                FontSize="12"
                                IsEnabled="{TemplateBinding CanGoNext}"
                                Style="{StaticResource Tessel.PageButton}"
                                ToolTip="Next page" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
