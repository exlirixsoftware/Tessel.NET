<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Tessel.NET.Controls">

    <!--  Small icon toggle used in the transport bar (loop, snap)  -->
    <Style x:Key="Tessel.TimelineBarToggle" TargetType="{x:Type ToggleButton}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{DynamicResource Tessel.TextSecondaryBrush}" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border x:Name="Bd"
                            Background="Transparent"
                            CornerRadius="{DynamicResource Tessel.ControlCornerRadius}">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="{DynamicResource Tessel.IconFontFamily}"
                                   FontSize="{DynamicResource Tessel.IconSize}"
                                   Foreground="{TemplateBinding Foreground}"
                                   Text="{TemplateBinding Content}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Tessel.ControlHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Tessel.AccentSubtleBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource Tessel.AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Eye toggle of a track header (checked = visible)  -->
    <Style x:Key="Tessel.TimelineVisibilityToggle" TargetType="{x:Type ToggleButton}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="{DynamicResource Tessel.SmallCornerRadius}">
                        <TextBlock x:Name="Glyph"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="{DynamicResource Tessel.IconFontFamily}"
                                   FontSize="13"
                                   Foreground="{DynamicResource Tessel.TextSecondaryBrush}"
                                   Text="&#xE7B3;" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Tessel.ControlHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="False">
                            <Setter TargetName="Glyph" Property="Text" Value="&#xED1A;" />
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Tessel.TextTertiaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Lock toggle of a track header (checked = locked)  -->
    <Style x:Key="Tessel.TimelineLockToggle" TargetType="{x:Type ToggleButton}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="{DynamicResource Tessel.SmallCornerRadius}">
                        <TextBlock x:Name="Glyph"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="{DynamicResource Tessel.IconFontFamily}"
                                   FontSize="13"
                                   Foreground="{DynamicResource Tessel.TextTertiaryBrush}"
                                   Text="&#xE785;" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Tessel.ControlHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Glyph" Property="Text" Value="&#xE72E;" />
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Tessel.AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Default track header: color bar, name, eye and lock  -->
    <DataTemplate x:Key="Tessel.AnimationTrackHeader" DataType="{x:Type c:AnimationTrack}">
        <Border Height="{Binding Height}"
                BorderBrush="{DynamicResource Tessel.BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Border Width="4"
                        Margin="0,5"
                        HorizontalAlignment="Left"
                        Background="{Binding DisplayBrush}"
                        CornerRadius="0,2,2,0" />
                <Grid Margin="14,0,6,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center"
                               Foreground="{DynamicResource Tessel.TextBrush}"
                               Text="{Binding Name}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Name}" />
                    <ToggleButton Grid.Column="1"
                                  IsChecked="{Binding IsVisible, Mode=TwoWay}"
                                  Style="{StaticResource Tessel.TimelineVisibilityToggle}"
                                  ToolTip="Show or hide the track" />
                    <ToggleButton Grid.Column="2"
                                  IsChecked="{Binding IsLocked, Mode=TwoWay}"
                                  Style="{StaticResource Tessel.TimelineLockToggle}"
                                  ToolTip="Lock the track" />
                </Grid>
            </Grid>
        </Border>
    </DataTemplate>

    <Style TargetType="{x:Type c:AnimationTimeline}">
        <Setter Property="Background" Value="{DynamicResource Tessel.SurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource Tessel.TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Tessel.BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{DynamicResource Tessel.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Tessel.FontSize}" />
        <Setter Property="MinHeight" Value="180" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="TrackHeaderTemplate" Value="{StaticResource Tessel.AnimationTrackHeader}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:AnimationTimeline}">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource Tessel.OverlayCornerRadius}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!--  Transport bar  -->
                            <Border x:Name="Transport"
                                    Padding="8,5"
                                    Background="{DynamicResource Tessel.SurfaceAltBrush}"
                                    BorderBrush="{DynamicResource Tessel.BorderBrush}"
                                    BorderThickness="0,0,0,1"
                                    CornerRadius="7,7,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="PART_ToStartButton"
                                                Content="&#xE892;"
                                                Style="{DynamicResource Tessel.Button.Icon}"
                                                ToolTip="Go to start (Home)" />
                                        <Button x:Name="PART_StepBackButton"
                                                Content="&#xE76B;"
                                                Style="{DynamicResource Tessel.Button.Icon}"
                                                ToolTip="Previous frame (Left)" />
                                        <Button x:Name="PART_PlayButton"
                                                Content="&#xE768;"
                                                Style="{DynamicResource Tessel.Button.Icon}"
                                                ToolTip="Play / pause (Space)" />
                                        <Button x:Name="PART_StepForwardButton"
                                                Content="&#xE76C;"
                                                Style="{DynamicResource Tessel.Button.Icon}"
                                                ToolTip="Next frame (Right)" />
                                        <Button x:Name="PART_ToEndButton"
                                                Content="&#xE893;"
                                                Style="{DynamicResource Tessel.Button.Icon}"
                                                ToolTip="Go to end (End)" />
                                        <Border Width="1"
                                                Height="18"
                                                Margin="6,0"
                                                Background="{DynamicResource Tessel.BorderStrongBrush}" />
                                        <ToggleButton Content="&#xE8EE;"
                                                      IsChecked="{Binding IsLoopEnabled, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                      Style="{StaticResource Tessel.TimelineBarToggle}"
                                                      ToolTip="Loop (Shift-drag the ruler to set a loop region)" />
                                        <ToggleButton Content="&#xE71B;"
                                                      IsChecked="{Binding IsSnappingEnabled, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                      Style="{StaticResource Tessel.TimelineBarToggle}"
                                                      ToolTip="Snap to clip edges, markers and the playhead" />
                                        <Border Width="1"
                                                Height="18"
                                                Margin="6,0"
                                                Background="{DynamicResource Tessel.BorderStrongBrush}" />
                                        <Button x:Name="PART_UndoButton"
                                                Content="&#xE7A7;"
                                                IsEnabled="{TemplateBinding CanUndo}"
                                                Style="{DynamicResource Tessel.Button.Icon}"
                                                ToolTip="Undo (Ctrl+Z)" />
                                        <Button x:Name="PART_RedoButton"
                                                Content="&#xE7A6;"
                                                IsEnabled="{TemplateBinding CanRedo}"
                                                Style="{DynamicResource Tessel.Button.Icon}"
                                                ToolTip="Redo (Ctrl+Y)" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                Margin="18,0,0,0"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal">
                                        <TextBlock FontFamily="{DynamicResource Tessel.MonoFontFamily}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Text="{TemplateBinding CurrentTimeText}" />
                                        <TextBlock Margin="6,0,0,0"
                                                   VerticalAlignment="Bottom"
                                                   FontFamily="{DynamicResource Tessel.MonoFontFamily}"
                                                   FontSize="{DynamicResource Tessel.FontSizeSmall}"
                                                   Foreground="{DynamicResource Tessel.TextSecondaryBrush}"
                                                   Text="{Binding DurationText, RelativeSource={RelativeSource TemplatedParent}, StringFormat='/ {0}'}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <Button x:Name="PART_ZoomOutButton"
                                                Content="&#xE738;"
                                                Style="{DynamicResource Tessel.Button.Icon}"
                                                ToolTip="Zoom out (Ctrl + mouse wheel)" />
                                        <Button x:Name="PART_ZoomInButton"
                                                Content="&#xE710;"
                                                Style="{DynamicResource Tessel.Button.Icon}"
                                                ToolTip="Zoom in (Ctrl + mouse wheel)" />
                                        <Button x:Name="PART_ZoomFitButton"
                                                Content="&#xE740;"
                                                Style="{DynamicResource Tessel.Button.Icon}"
                                                ToolTip="Fit the whole project" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!--  Track names, ruler and tracks  -->
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="{TemplateBinding HeaderWidth}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="38" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Border Background="{DynamicResource Tessel.SurfaceAltBrush}"
                                            BorderBrush="{DynamicResource Tessel.BorderStrongBrush}"
                                            BorderThickness="0,0,1,1">
                                        <ContentPresenter Margin="12,0"
                                                          VerticalAlignment="Center"
                                                          Content="{TemplateBinding HeaderCorner}"
                                                          TextElement.FontSize="{DynamicResource Tessel.FontSizeSmall}"
                                                          TextElement.Foreground="{DynamicResource Tessel.TextSecondaryBrush}" />
                                    </Border>
                                    <Border Grid.Row="1"
                                            BorderBrush="{DynamicResource Tessel.BorderBrush}"
                                            BorderThickness="0,0,1,0"
                                            ClipToBounds="True">
                                        <ItemsControl x:Name="PART_Headers"
                                                      Focusable="False"
                                                      ItemTemplate="{TemplateBinding TrackHeaderTemplate}"
                                                      ItemsSource="{Binding Tracks, RelativeSource={RelativeSource TemplatedParent}}"
                                                      VerticalAlignment="Top" />
                                    </Border>
                                </Grid>
                                <c:AnimationTimelineSurface x:Name="PART_Surface" Grid.Column="1" />
                                <ScrollBar x:Name="PART_VerticalScrollBar"
                                           Grid.Column="2"
                                           Margin="0,38,0,0"
                                           Orientation="Vertical" />
                            </Grid>

                            <!--  Horizontal scroll bar under the tracks  -->
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                </Grid.ColumnDefinitions>
                                <Border Width="{TemplateBinding HeaderWidth}"
                                        Height="12"
                                        Background="{DynamicResource Tessel.SurfaceAltBrush}" />
                                <ScrollBar x:Name="PART_HorizontalScrollBar"
                                           Grid.Column="1"
                                           Orientation="Horizontal" />
                            </Grid>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPlaying" Value="True">
                            <Setter TargetName="PART_PlayButton" Property="Content" Value="&#xE769;" />
                        </Trigger>
                        <Trigger Property="ShowTransport" Value="False">
                            <Setter TargetName="Transport" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
