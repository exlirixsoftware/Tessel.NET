<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--  Typography  -->
    <FontFamily x:Key="Tessel.FontFamily">Segoe UI</FontFamily>
    <FontFamily x:Key="Tessel.IconFontFamily">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="Tessel.MonoFontFamily">Cascadia Mono, Consolas</FontFamily>

    <sys:Double x:Key="Tessel.FontSizeSmall">12</sys:Double>
    <sys:Double x:Key="Tessel.FontSize">14</sys:Double>
    <sys:Double x:Key="Tessel.FontSizeLarge">16</sys:Double>
    <sys:Double x:Key="Tessel.IconSize">16</sys:Double>

    <!--  Shape  -->
    <CornerRadius x:Key="Tessel.SmallCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="Tessel.ControlCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="Tessel.OverlayCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="Tessel.LargeCornerRadius">12</CornerRadius>

    <!--  Focus  -->
    <Style x:Key="Tessel.FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3"
                            BorderBrush="{DynamicResource Tessel.AccentBrush}"
                            BorderThickness="2"
                            CornerRadius="8"
                            SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Text styles  -->
    <Style x:Key="Tessel.Text" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource Tessel.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Tessel.FontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource Tessel.TextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Tessel.Text.Display" BasedOn="{StaticResource Tessel.Text}" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="40" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="Tessel.Text.Title" BasedOn="{StaticResource Tessel.Text}" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="Tessel.Text.Subtitle" BasedOn="{StaticResource Tessel.Text}" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="Tessel.Text.BodyStrong" BasedOn="{StaticResource Tessel.Text}" TargetType="{x:Type TextBlock}">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="Tessel.Text.Body" BasedOn="{StaticResource Tessel.Text}" TargetType="{x:Type TextBlock}" />

    <Style x:Key="Tessel.Text.Secondary" BasedOn="{StaticResource Tessel.Text}" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource Tessel.TextSecondaryBrush}" />
    </Style>

    <Style x:Key="Tessel.Text.Caption" BasedOn="{StaticResource Tessel.Text}" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="{DynamicResource Tessel.FontSizeSmall}" />
        <Setter Property="Foreground" Value="{DynamicResource Tessel.TextSecondaryBrush}" />
    </Style>

    <Style x:Key="Tessel.Text.Code" BasedOn="{StaticResource Tessel.Text}" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource Tessel.MonoFontFamily}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style x:Key="Tessel.Text.Icon" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource Tessel.IconFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Tessel.IconSize}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

</ResourceDictionary>
